<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NorthwindTradersV8WebRazorPages</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NorthwindTradersV8WebRazorPages.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">NorthwindTradersV8WebRazorPages</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>

                        <!-- Menú  empleados con submenús -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="empleadosDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Empleados
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="empleadosDropdown">

                                <!-- Gestión de empleados -->
                                <li><a class="dropdown-item" asp-area="" asp-page="/Empleados/Index">Gestión de empleados</a></li>
                                <li><hr class="dropdown-divider" /></li>

                                <!-- Submenú Reportes -->
                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle" href="#">Reportes</a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item"
                                                asp-page="/Empleados/Reportes/RptEmpleados">
                                                Reporte de empleados
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" 
                                                asp-page="/Empleados/Reportes/RptEmpleadosConFoto">
                                                Reporte de empleados con foto
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" 
                                                asp-page="/Empleados/Reportes/RptEmpleadosConFoto2">
                                                Reporte de empleados con foto 2
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </li>

                        <!-- Menú  clientes con submenús -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="clientesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Clientes
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="clientesDropdown">

                                <!-- Gestión de clientes -->
                                <li><a class="dropdown-item" asp-area="" asp-page="/Clientes/Index">Gestión de clientes</a></li>
                                <li><hr class="dropdown-divider" /></li>

                                <!-- Submenú Consultas -->
                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle" href="#">Consultas</a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Clientes/Consultas/DirectorioClientesProveedores">
                                                Directorio de clientes y proveedores
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Clientes/Consultas/DirectorioPorCiudadClientesProveedores">
                                                Directorio de clientes y proveedores por ciudad
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Clientes/Consultas/DirectorioPorPaisClientesProveedores">
                                                Directorio de clientes y proveedores por país
                                            </a>
                                        </li>
                                    </ul>
                                </li>

                                    <!-- Submenú Reportes -->
                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle" href="#">Reportes</a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Clientes/Reportes/DirectorioClientesRpt">
                                                Directorio de clientes
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Clientes/Reportes/DirectorioClientesProveedoresRpt">
                                                Directorio de clientes y proveedores
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Clientes/Reportes/DirectorioPorCiudadClientesProveedoresRpt">
                                                Directorio de clientes y proveedores por ciudad
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Clientes/Reportes/DirectorioPorPaisClientesProveedoresRpt">
                                                Directorio de clientes y proveedores por país
                                            </a>
                                        </li>
                                    </ul>
                                </li>   
                            </ul>
                        </li>

                        <!-- Menú  proveedores con submenús -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="proveedoresDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Proveedores
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="proveedoresDropdown">

                                <!-- Gestión de proveedores -->
                                <li><a class="dropdown-item" asp-area="" asp-page="/Proveedores/Index">Gestión de proveedores</a></li>
                                <li><hr class="dropdown-divider" /></li>

                                <!-- Submenú Consultas -->
                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle" href="#">Consultas</a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Clientes/Consultas/DirectorioClientesProveedores">
                                                Directorio de clientes y proveedores
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Clientes/Consultas/DirectorioPorCiudadClientesProveedores">
                                                Directorio de clientes y proveedores por ciudad
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Clientes/Consultas/DirectorioPorPaisClientesProveedores">
                                                Directorio de clientes y proveedores por país
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Proveedores/Consultas/BuscarProveedorProductos">
                                                Consulta de productos por proveedor
                                            </a>
                                        </li>
                                    </ul>
                                </li>

                                <!-- Submenú Reportes -->
                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle" href="#">Reportes</a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Proveedores/Reportes/DirectorioProveedoresRpt">
                                                Directorio de proveedores
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Clientes/Reportes/DirectorioClientesProveedoresRpt">
                                                Directorio de clientes y proveedores
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Clientes/Reportes/DirectorioPorCiudadClientesProveedoresRpt">
                                                Directorio de clientes y proveedores por ciudad
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Clientes/Reportes/DirectorioPorPaisClientesProveedoresRpt">
                                                Directorio de clientes y proveedores por país
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Proveedores/Reportes/ProductosPorProveedorRpt">
                                                Reporte de productos por proveedor
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Proveedores/Reportes/ProductosPorProveedorConDetalleProveedorRpt">
                                                Reporte de productos por proveedor con detalle del proveedor
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </li>
                        <!-- Menú Categorías con submenús -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="categoriasDropDown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Categorías
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="categoriasDropDown">
                                <!-- Gestión de categorías -->
                                <li>
                                    <a class="dropdown-item" 
                                        asp-area="" 
                                        asp-page="/Categorias/Index">
                                            Gestión de categorías
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <!-- Submenú Consultas -->
                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle" href="#">Consultas</a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item"
                                                asp-page="/Categorias/Consultas/BuscarCategoriasProductos">
                                                Consulta de productos por categoría
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Categorias/Consultas/ListadoCategoriasConProductos">
                                                Listado de categorías con productos
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                                <!-- Submenú Reportes -->
                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle" href="#">Reportes</a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Categorias/Reportes/CategoriasRpt">
                                                Reporte de categorías
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="/Categorias/Reportes/CategoriasConProductosRpt">
                                                Reporte de categorías con productos
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </li>
                        <!-- Menú Productos con submenús -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="productosDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Productos
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="productosDropdown">

                                <!-- Gestión de productos -->
                                <li><a class="dropdown-item" asp-area="" asp-page="/Productos/Index">Gestión de productos</a></li>
                                <li><hr class="dropdown-divider" /></li>

                                <!-- Consultas con submenú -->
                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle" href="#">Consultas</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-page="/Productos/ConsultarPorCategoria">Listado de productos</a></li>
                                        <li><a class="dropdown-item" asp-page="/Categorias/Consultas/BuscarCategoriasProductos">Consulta de productos por categoría</a></li>
                                        <li><a class="dropdown-item" asp-page="/Proveedores/Consultas/BuscarProveedorProductos">Consulta de productos por proveedor</a></li>
                                        <li><a class="dropdown-item" asp-page="/Productos/ConsultarStock">Consulta alfabética de productos</a></li>
                                        <li><a class="dropdown-item" asp-page="/Categorias/Consultas/ListadoCategoriasConProductos">Listado de categorías con productos</a></li>
                                        <li><a class="dropdown-item" asp-page="/Productos/ConsultarStock">Productos por encima del precio promedio</a></li>
                                    </ul>
                                </li>

                                <!-- Reportes con submenú -->
                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle" href="#">Reportes</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-page="/Productos/Reportes/ProductosRpt">Reporte de productos</a></li>
                                        <li><a class="dropdown-item" asp-page="/Productos/Reportes/ProductosAlfabeticoRpt">Reporte de productos en orden alfabético</a></li>
                                        <li><a class="dropdown-item" asp-page="/Proveedores/Reportes/ProductosPorProveedorRpt">Reporte de productos por proveedor</a></li>
                                        <li><a class="dropdown-item" asp-page="/Proveedores/Reportes/ProductosPorProveedorConDetalleProveedorRpt">Reporte de productos por proveedor con detalle del proveedor</a></li>
                                        <li><a class="dropdown-item" asp-page="/Categorias/Reportes/CategoriasConProductosRpt">Reporte de categorías con productos</a></li>
                                    </ul>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                    </ul>

                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - NorthwindTradersV8WebRazorPages - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <!-- 👇 Select2 debe ir después de jQuery -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="~/js/loading-overlay.js" asp-append-version="true"></script>

    <partial name="_LoadingOverlay" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
