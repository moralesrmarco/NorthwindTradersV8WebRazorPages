@using NorthwindTradersV8WebRazorPages.Common

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NorthwindTradersV8WebRazorPages</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NorthwindTradersV8WebRazorPages.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Northwind Traders</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <!-- Menú  empleados con submenús -->
                        @if (User.HasClaim("Permiso", Permisos.Empleados.ToString()))
                        {
                            <!-- Menú Empleados con submenús -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark"
                                   href="#"
                                   id="empleadosDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    Empleados
                                </a>

                                <ul class="dropdown-menu" aria-labelledby="empleadosDropdown">

                                    <!-- Gestión de empleados -->
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area=""
                                           asp-page="/Empleados/Index">
                                            Gestión de empleados
                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <!-- Submenú Reportes -->
                                    <li class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#">
                                            Reportes
                                        </a>

                                        <ul class="dropdown-menu">
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/Empleados/Reportes/RptEmpleados">
                                                    Reporte de empleados
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/Empleados/Reportes/RptEmpleadosConFoto">
                                                    Reporte de empleados con foto
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/Empleados/Reportes/RptEmpleadosConFoto2">
                                                    Reporte de empleados con foto 2
                                                </a>
                                            </li>
                                        </ul>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <!-- Empleados sin permiso: visible pero deshabilitado -->
                            <li class="nav-item">
                                <span class="nav-link text-dark menu-deshabilitado">
                                    Empleados
                                </span>
                            </li>
                        }

                        <!-- Menú  clientes con submenús -->
                        @if (User.HasClaim("Permiso", Permisos.Clientes.ToString()))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="clientesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Clientes
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="clientesDropdown">

                                    <!-- Gestión de clientes -->
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Clientes/Index">Gestión de clientes</a></li>
                                    <li><hr class="dropdown-divider" /></li>

                                    <!-- Submenú Consultas -->
                                    <li class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#">Consultas</a>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/ClientesProveedoresComun/Consultas/DirectorioClientesProveedores">
                                                    Directorio de clientes y proveedores
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/ClientesProveedoresComun/Consultas/DirectorioPorCiudadClientesProveedores">
                                                    Directorio de clientes y proveedores por ciudad
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/ClientesProveedoresComun/Consultas/DirectorioPorPaisClientesProveedores">
                                                    Directorio de clientes y proveedores por país
                                                </a>
                                            </li>
                                        </ul>
                                    </li>

                                        <!-- Submenú Reportes -->
                                    <li class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#">Reportes</a>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/Clientes/Reportes/DirectorioClientesRpt">
                                                    Directorio de clientes
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/ClientesProveedoresComun/Reportes/DirectorioClientesProveedoresRpt">
                                                    Directorio de clientes y proveedores
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/ClientesProveedoresComun/Reportes/DirectorioPorCiudadClientesProveedoresRpt">
                                                    Directorio de clientes y proveedores por ciudad
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/ClientesProveedoresComun/Reportes/DirectorioPorPaisClientesProveedoresRpt">
                                                    Directorio de clientes y proveedores por país
                                                </a>
                                            </li>
                                        </ul>
                                    </li>   
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <span class="nav-link text-dark menu-deshabilitado">
                                    Clientes
                                </span>
                            </li>
                        }

                        <!-- Menú  proveedores con submenús -->
                        @if (User.HasClaim("Permiso", Permisos.Proveedores.ToString()))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="proveedoresDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Proveedores
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="proveedoresDropdown">

                                    <!-- Gestión de proveedores -->
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Proveedores/Index">Gestión de proveedores</a></li>
                                    <li><hr class="dropdown-divider" /></li>

                                    <!-- Submenú Consultas -->
                                    <li class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#">Consultas</a>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/ClientesProveedoresComun/Consultas/DirectorioClientesProveedores">
                                                    Directorio de clientes y proveedores
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/ClientesProveedoresComun/Consultas/DirectorioPorCiudadClientesProveedores">
                                                    Directorio de clientes y proveedores por ciudad
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/ClientesProveedoresComun/Consultas/DirectorioPorPaisClientesProveedores">
                                                    Directorio de clientes y proveedores por país
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/ProveedoresProductosComun/Consultas/BuscarProveedorProductos">
                                                    Consulta de productos por proveedor
                                                </a>
                                            </li>
                                        </ul>
                                    </li>

                                    <!-- Submenú Reportes -->
                                    <li class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#">Reportes</a>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/Proveedores/Reportes/DirectorioProveedoresRpt">
                                                    Directorio de proveedores
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/ClientesProveedoresComun/Reportes/DirectorioClientesProveedoresRpt">
                                                    Directorio de clientes y proveedores
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/ClientesProveedoresComun/Reportes/DirectorioPorCiudadClientesProveedoresRpt">
                                                    Directorio de clientes y proveedores por ciudad
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/ClientesProveedoresComun/Reportes/DirectorioPorPaisClientesProveedoresRpt">
                                                    Directorio de clientes y proveedores por país
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/ProveedoresProductosComun/Reportes/ProductosPorProveedorRpt">
                                                    Reporte de productos por proveedor
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/ProveedoresProductosComun/Reportes/ProductosPorProveedorConDetalleProveedorRpt">
                                                    Reporte de productos por proveedor con detalle del proveedor
                                                </a>
                                            </li>
                                        </ul>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <span class="nav-link text-dark menu-deshabilitado">
                                    Proveedores
                                </span>
                            </li>
                        }

                        <!-- Menú Categorías con submenús -->
                        @if (User.HasClaim("Permiso", Permisos.Categorias.ToString()))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="categoriasDropDown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Categorías
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="categoriasDropDown">
                                    <!-- Gestión de categorías -->
                                    <li>
                                        <a class="dropdown-item" 
                                            asp-area="" 
                                            asp-page="/Categorias/Index">
                                                Gestión de categorías
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <!-- Submenú Consultas -->
                                    <li class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#">Consultas</a>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a class="dropdown-item"
                                                    asp-page="/CategoriasProductosComun/Consultas/BuscarCategoriasProductos">
                                                    Consulta de productos por categoría
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/CategoriasProductosComun/Consultas/ListadoCategoriasConProductos">
                                                    Listado de categorías con productos
                                                </a>
                                            </li>
                                        </ul>
                                    </li>
                                    <!-- Submenú Reportes -->
                                    <li class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#">Reportes</a>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/Categorias/Reportes/CategoriasRpt">
                                                    Reporte de categorías
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-page="/CategoriasProductosComun/Reportes/CategoriasConProductosRpt">
                                                    Reporte de categorías con productos
                                                </a>
                                            </li>
                                        </ul>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <span class="nav-link text-dark menu-deshabilitado">
                                    Categorías
                                </span>
                            </li>
                        }

                        <!-- Menú Productos con submenús -->
                        @if (User.HasClaim("Permiso", Permisos.Productos.ToString()))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="productosDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Productos
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="productosDropdown">

                                    <!-- Gestión de productos -->
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Productos/Index">Gestión de productos</a></li>
                                    <li><hr class="dropdown-divider" /></li>

                                    <!-- Consultas con submenú -->
                                    <li class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#">Consultas</a>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" asp-page="/Productos/Consultas/ListadoProductos">Listado de productos</a></li>
                                            <li><a class="dropdown-item" asp-page="/CategoriasProductosComun/Consultas/BuscarCategoriasProductos">Consulta de productos por categoría</a></li>
                                            <li><a class="dropdown-item" asp-page="/ProveedoresProductosComun/Consultas/BuscarProveedorProductos">Consulta de productos por proveedor</a></li>
                                            <li><a class="dropdown-item" asp-page="/Productos/Consultas/ListadoAlfabeticoProductos">Consulta alfabética de productos</a></li>
                                            <li><a class="dropdown-item" asp-page="/CategoriasProductosComun/Consultas/ListadoCategoriasConProductos">Listado de categorías con productos</a></li>
                                            <li><a class="dropdown-item" asp-page="/Productos/Consultas/ProductosPorEncimaDelPrecioPromedio">Productos por encima del precio promedio</a></li>
                                        </ul>
                                    </li>

                                    <!-- Reportes con submenú -->
                                    <li class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#">Reportes</a>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" asp-page="/Productos/Reportes/ProductosRpt">Reporte de productos</a></li>
                                            <li><a class="dropdown-item" asp-page="/Productos/Reportes/ProductosAlfabeticoRpt">Reporte de productos en orden alfabético</a></li>
                                            <li><a class="dropdown-item" asp-page="/ProveedoresProductosComun/Reportes/ProductosPorProveedorRpt">Reporte de productos por proveedor</a></li>
                                            <li><a class="dropdown-item" asp-page="/ProveedoresProductosComun/Reportes/ProductosPorProveedorConDetalleProveedorRpt">Reporte de productos por proveedor con detalle del proveedor</a></li>
                                            <li><a class="dropdown-item" asp-page="/CategoriasProductosComun/Reportes/CategoriasConProductosRpt">Reporte de categorías con productos</a></li>
                                        </ul>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <span class="nav-link text-dark menu-deshabilitado">
                                    Productos
                                </span>
                            </li>
                        }

                        <!-- Menú Ventas con submenús -->
                        @if (User.HasClaim("Permiso", Permisos.Ventas.ToString()))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="ventasDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Ventas
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="ventasDropdown">
                                    <!-- Gestión de ventas -->
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventas/Index">Gestión de ventas</a></li>
                                    <li><hr class="dropdown-divider" /></li>

                                    <!-- Reportes con submenú -->
                                    <li class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#">Reportes</a>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" asp-page="/Ventas/Reportes/VentasRpt">Reporte de ventas</a></li>
                                        </ul>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <span class="nav-link text-dark menu-deshabilitado">
                                    Ventas
                                </span>
                            </li>
                        }

                        <!-- Menú Gráficas con submenús -->
                        @if (User.HasClaim("Permiso", Permisos.Graficas.ToString()))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="graficasDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Gráficas
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="graficasDropdown">

                                    <!-- Consultas con submenú -->
                                    <li class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#">Consultas</a>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" asp-page="/Graficas/Consultas/VentasMensuales">Ventas mensuales</a></li>
                                            <li><a class="dropdown-item" asp-page="/Graficas/Consultas/VentasAnuales">Comparativo de ventas anuales</a></li>
                                            <li><a class="dropdown-item" asp-page="/Graficas/Consultas/TopProductosMasVendidos">Top productos más vendidos</a></li>
                                            <li><a class="dropdown-item" asp-page="/Graficas/Consultas/VentasPorVendedoresPorAnio">Ventas por vendedores por año</a></li>
                                            <li><a class="dropdown-item" asp-page="/Graficas/Consultas/VentasMensualesPorVendedorPorAnio">Ventas mensuales por vendedor por año</a></li>
                                            <li><a class="dropdown-item" asp-page="/Graficas/Consultas/VentasPorVendedoresPorAnioBarras">Ventas por vendedores por año (Barras)</a></li>
                                            <li><a class="dropdown-item" asp-page="/Graficas/Consultas/EjemploGraficas">Ejemplo de gráficas</a></li>
                                            <li><a class="dropdown-item" asp-page="/Graficas/Consultas/EjemploGraficas2">Ejemplo de gráficas 2</a></li>
                                            <li><a class="dropdown-item" asp-page="/Graficas/Consultas/EjemploGraficas3">Ejemplo de gráficas 3</a></li>
                                        </ul>
                                    </li>

                                    <!-- Reportes con submenú -->
                                    <li class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#">Reportes</a>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" asp-page="/Graficas/Reportes/VentasMensualesRpt">Ventas mensuales</a></li>
                                        </ul>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <span class="nav-link text-dark menu-deshabilitado">
                                    Gráficas
                                </span>
                            </li>
                        }


                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <i class="bi bi-person-circle"></i>
                                    @User.FindFirst("Usuario")?.Value
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-page="/Account/CambiarPassword">
                                            <i class="bi bi-key"></i>
                                            Cambiar contraseña
                                        </a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <form method="post" asp-page="/Account/Logout">
                                            <button type="submit" class="dropdown-item">
                                                <i class="bi bi-box-arrow-right"></i>
                                                Cerrar sesión
                                            </button>
                                        </form>
                                    </li>

                                </ul>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - NorthwindTradersV8WebRazorPages - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <!-- 👇 Select2 debe ir después de jQuery -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="~/js/loading-overlay.js" asp-append-version="true"></script>

    <partial name="_LoadingOverlay" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
