        function cargarProductos(categoriaId, productoSeleccionado, alTerminar) {
            $("#cboProducto").empty();
            // Si el usuario volvió a seleccionar "Seleccione"
            if (categoriaId == "") {
                $("#cboProducto").append(
                    $("<option>")
                        .val("")
