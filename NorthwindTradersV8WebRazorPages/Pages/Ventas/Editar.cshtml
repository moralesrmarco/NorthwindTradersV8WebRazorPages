        function agregarProducto() {
            if ($("#cboCategoria").val() == "") {
                alert("Debe seleccionar una categoría.");
                $("#cboCategoria").focus();
                return;
            }
            if ($("#cboProducto").val() == "") {
                alert("Debe seleccionar un producto.");
                $("#cboProducto").focus();
                return;
            }
            if (Number($("#Detalle_Quantity").val()) <= 0) {
                alert("La cantidad debe ser mayor que 0.");
                $("#Detalle_Quantity").focus().select();
                return;
            }
            if (Number($("#Detalle_Quantity").val()) >
                Number($("#Detalle_UnitsInStock").val())) {
                alert("La cantidad no puede ser mayor que las unidades en inventario.");
                $("#Detalle_Quantity").focus().select();
                return;
            }
            let descuento = Number($("#Detalle_Discount").val());
            if (descuento < 0 || descuento > 95.00) {
                alert("El descuento debe estar entre 0 y 95.00%.");
                $("#Detalle_Discount").focus().select();
                return;
            }
            // ===== VALIDAR PRODUCTO DUPLICADO =====
            let productoId = Number($("#cboProducto").val());
            let repetido = false;
            $("#tblDetalle tr").each(function() {
                let id = Number($(this).find("td:last").text().trim());

                if (id === productoId) {
                    repetido = true;
                    return false; // break
                }
            });
            if (repetido) {
                alert("No se puede agregar un mismo producto más de una vez a la venta.");
                $("#cboProducto").focus();
                return;
            }
            // ===== FIN VALIDACIÓN =====
            // ===== CREAR REQUEST PARA EL BACKEND =====
            let request = {
                OrderID: Number($("#VentaVM_OrderID").val()),
                RowVersion: $("#VentaVM_RowVersion").val(),
                Detalle: {
                    CategoriaID: Number($("#cboCategoria").val()),
                    ProductID: Number($("#cboProducto").val()),
                    ProductName: $("#cboProducto option:selected").text(),
                    UnitPrice: Number($("#Detalle_UnitPrice").val()),
                    UnitsInStock: Number($("#Detalle_UnitsInStock").val()),
                    Quantity: Number($("#Detalle_Quantity").val()),
                    Discount: Number($("#Detalle_Discount").val()) / 100,
                    TasaIVA: Number($("#VentaVM_TasaIVA").val())
                }
            };

            $.ajax({
                url: "?handler=AgregarDetalle",
                type: "POST",
                contentType: "application/json",
                dataType: "json",
                headers: {
                    "RequestVerificationToken":
                        $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify(request),

                success: function(r) {
                    if (r.ok) {
                        limpiarErrorValidacion();
                        // Actualizar RowVersion de la venta
                        $("#VentaVM_RowVersion").val(r.rowVersion);
                        // Actualizar tabla con los datos reales de la BD
                        llenarTabla(r.lista);
                        // Actualizar totales
                        mostrarTotales(r.totales);
                        // Limpiar captura del producto
                        limpiarCapturaProducto();
                    }
                    else {
                        mostrarErrorValidacion(r.mensaje);
                        if (
                            r.codigo === -3 ||
                            r.codigo === -4 ||
                            r.codigo === -10 ||
                            r.codigo === -99
                        ) {
                            bloquearEdicionPorConcurrencia();
                        }
                    }
                },
                error: function(xhr) {
                    mostrarErrorValidacion(
                        xhr.responseJSON?.mensaje ||
                        "Ocurrió un error al insertar el detalle."
                    );
                    console.error(xhr);
                }
            });
        }

