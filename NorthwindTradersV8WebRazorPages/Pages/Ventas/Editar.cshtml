        function actualizarDetalle() {
            const quantity = Number($("#Detalle_Quantity").val());
            const discount = Number($("#Detalle_Discount").val()) / 100;
            if (quantity <= 0) {
                alert("La cantidad debe ser mayor que 0.");
                $("#Detalle_Quantity").focus().select();
                return;
            }
            if (discount < 0 || discount > 0.95) {
                alert("El descuento debe estar entre 0 y 95.00%.");
                $("#Detalle_Discount").focus().select();
                return;
            }
            const request = {
                OrderID: Number($("#VentaVM_OrderID").val()),
                ProductID: detalleEnEdicion.productID,
                Quantity: quantity,
                Discount: discount,
                VentaDetalleRowVersion: detalleEnEdicion.rowVersion,
                VentaRowVersion: $("#VentaVM_RowVersion").val()
            };
            $("#btnAgregarProducto").prop("disabled", true);
            $.ajax({
                url: "?handler=ActualizarDetalle",
                type: "POST",
                contentType: "application/json",
                dataType: "json",
                headers: {
                    "RequestVerificationToken":
                        $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify(request),
                success: function(r) {
                    if (r.ok) {
                        limpiarErrorValidacion();
                        // Actualizar RowVersion de la venta
                        $("#VentaVM_RowVersion").val(r.rowVersion);
                        // Actualizar tabla
                        llenarTabla(r.lista);
                        // Actualizar totales
                        mostrarTotales(r.totales);
                        // Salir del modo edición
                        salirModoEdicion();
                    }
                    else {
                        mostrarErrorValidacion(r.mensaje);
                        /*
                         * Estos códigos corresponden a problemas
                         * de la venta que impiden seguir editando.
                         */
                        if (
                            r.codigo === -1 ||
                            r.codigo === -2 ||
                            r.codigo === -3 ||
                            r.codigo === -4 ||
                            r.codigo === -99
                        ) {
                            salirModoEdicion();
                            bloquearEdicionPorConcurrencia();
                        }
                        else {
                            $("#btnAgregarProducto")
                                .prop("disabled", false);
                        }
                    }
                },
                error: function(xhr) {
                    mostrarErrorValidacion(
                        xhr.responseJSON?.mensaje ||
                        "Ocurrió un error al actualizar el detalle."
                    );
                    console.error(xhr);
                    $("#btnAgregarProducto")
                        .prop("disabled", false);
                }
            });
        }

        function salirModoEdicion() {

            detalleEnEdicion = null;

            if (!ventaBloqueada) {

                $("#cboCategoria, #cboProducto")
                    .prop("disabled", false);

                $("#Detalle_Quantity")
                    .prop("disabled", false);

                $("#Detalle_Discount")
                    .prop("disabled", false);

                $(".btnEditar, .btnEliminar")
                    .prop("disabled", false);
            }

            $("#btnAgregarProducto")
                .prop("disabled", ventaBloqueada)
                .attr("title", "Agregar")
                .find("span")
                .text(" Agregar");

            $("#btnAgregarProducto i")
                .attr("class", "bi bi-plus-lg");

            $("#btnCancelarEdicion")
                .addClass("d-none");

            $("#cboCategoria").val("");

            cargarProductos("");

            limpiarCapturaProducto();
        }

        function eliminarProducto(productID, rowVersion) {
            if (!confirm("¿Está seguro de eliminar este producto?")) {
                return;
            }
            let request = {
                OrderID: Number($("#VentaVM_OrderID").val()),
                ProductID: productID,
                RowVersion: rowVersion,
                VentaRowVersion: $("#VentaVM_RowVersion").val()
            };
            $.ajax({
                type: "POST",
                url: "?handler=EliminarDetalle",
                contentType: "application/json; charset=utf-8",
                headers: {
                    "RequestVerificationToken":
                        $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify(request),
                success: function(r) {
                    if (r.ok) {
                        limpiarErrorValidacion();
                        // Actualizar RowVersion de Orders
                        $("#VentaVM_RowVersion")
                            .val(r.rowVersion);
                        // Actualizar tabla
                        llenarTabla(r.lista);
                        // Actualizar totales
                        mostrarTotales(r.totales);
                    }
                    else {
                        mostrarErrorValidacion(
                            r.mensaje ||
                            "No se pudo eliminar el detalle."
                        );

                        if (
                            r.codigo === -1 ||
                            r.codigo === -2 ||
                            r.codigo === -3 ||
                            r.codigo === -4 ||
                            r.codigo === -99
                        ) {
                            bloquearEdicionPorConcurrencia();
                        }
                    }
                },
                error: function(xhr) {
                    console.error(xhr);
                    alert(
                        "Ocurrió un error al eliminar el detalle."
                    );
                }
            });
        }

        function editarProducto(productID, rowVersion) {

            if (ventaBloqueada) {
                return;
            }

            const request = {
                OrderID: Number($("#VentaVM_OrderID").val()),
                ProductID: productID,
                RowVersion: rowVersion
            };

            $.ajax({
                url: "?handler=ObtenerDetalleEditar",
                type: "POST",
                contentType: "application/json",

                headers: {
                    "RequestVerificationToken":
                        $('input[name="__RequestVerificationToken"]').val()
                },

                data: JSON.stringify(request),

                success: function(r) {

                    if (r.success) {

                        detalleEnEdicion = {
                            productID: r.detalle.productID,
                            rowVersion: r.detalle.rowVersion
                        };

                        $("#cboCategoria")
                            .val(r.detalle.categoriaID);

                        cargarProductos(
                            r.detalle.categoriaID,
                            r.detalle.productID,
                            function() {

                                $("#Detalle_UnitPrice")
                                    .val(r.detalle.unitPrice);

                                $("#Detalle_UnitsInStock")
                                    .val(r.detalle.unitsInStock);

                                $("#Detalle_Quantity")
                                    .val(r.detalle.quantity);

                                $("#Detalle_Discount")
                                    .val(r.detalle.discount * 100);

                                // No permitir cambiar el producto
                                $("#cboCategoria, #cboProducto")
                                    .prop("disabled", true);

                                // Evitar editar/eliminar otro detalle
                                $(".btnEditar, .btnEliminar")
                                    .prop("disabled", true);

                                // Cambiar botón Agregar por Guardar
                                $("#btnAgregarProducto")
                                    .prop("disabled", false)
                                    .attr("title", "Guardar cambios")
                                    .find("span")
                                    .text(" Guardar cambios");

                                $("#btnAgregarProducto i")
                                    .attr("class", "bi bi-floppy");

                                $("#btnCancelarEdicion")
                                    .removeClass("d-none")
                                    .prop("disabled", false);

                                calcularDetalle();

                                $("#Detalle_Quantity")
                                    .focus()
                                    .select();
                            }
                        );
                    }
                    else {

                        mostrarErrorValidacion(
                            r.message ||
                            "No se pudo obtener el detalle para editar."
                        );

                        if (
                            r.bloquearEdicionPorConcurrencia === true
                        ) {
                            bloquearEdicionPorConcurrencia();
                        }
                    }
                },

                error: function(xhr) {

                    console.error(xhr);

                    mostrarErrorValidacion(
                        xhr.responseJSON?.message ||
                        "Ocurrió un error al obtener el detalle."
                    );
                }
            });
        }

        // ===== EVENTOS =====
        $(document).on("click", ".btnSeleccionar", function() {
            let indice = $(this).data("index");
            let fila = $("#tbodyFormasEnvio tr")
                .eq(indice);
            $("#VentaVM_ShipName")
                .val(fila.find("td:eq(1)").text());
            $("#VentaVM_ShipAddress")
                .val(fila.find("td:eq(2)").text());
            $("#VentaVM_ShipCity")
                .val(fila.find("td:eq(3)").text());
            $("#VentaVM_ShipRegion")
                .val(fila.find("td:eq(4)").text());
            $("#VentaVM_ShipPostalCode")
                .val(fila.find("td:eq(5)").text());
            $("#VentaVM_ShipCountry")
                .val(fila.find("td:eq(6)").text());
            // Seleccionar compañía transportista
            let shipVia = fila.find("td:eq(7)").text();
            $("#cboCompañia")
                .val(shipVia)
                .trigger("change");
            let modal = bootstrap.Modal.getInstance(
                document.getElementById("modalFormasEnvio")
            );
            modal.hide();
        });

        $("#btnLimpiarEnvio").click(function() {
            $("#cboCompañia").val("");
            $("#VentaVM_ShipName").val("");
            $("#VentaVM_ShipAddress").val("");
            $("#VentaVM_ShipCity").val("");
            $("#VentaVM_ShipRegion").val("");
            $("#VentaVM_ShipPostalCode").val("");
            $("#VentaVM_ShipCountry").val("");
            $("#VentaVM_Freight").val(0);
            // Guardar inmediatamente los cambios en la BD
            actualizarEnvio();
        });

        $(
            "#cboVendedor," +
            "#VentaVM_OrderDate," +
            "#VentaVM_OrderTime," +
            "#VentaVM_RequiredDate," +
            "#VentaVM_RequiredTime," +
            "#VentaVM_ShippedDate," +
            "#VentaVM_ShippedTime"
        ).on("change", actualizarEncabezado);

        $(
            "#VentaVM_ShipName," +
            "#VentaVM_ShipAddress," +
            "#VentaVM_ShipCity," +
            "#VentaVM_ShipRegion," +
            "#VentaVM_ShipPostalCode," +
            "#VentaVM_ShipCountry," +
            "#cboCompañia," +
            "#VentaVM_Freight"
        ).on("change", actualizarEnvio);

        $("#btnSeleccionarEnvio").click(function() {
            cargarFormasEnvio();
        });

        $("#cboCategoria").change(function() {
            cargarProductos($(this).val());
        });

        $("#cboProducto").change(function() {
            cargarInformacionProducto($(this).val());
        });

        $("#Detalle_Quantity").on("input", calcularDetalle);

        $("#Detalle_Discount").on("input", calcularDetalle);

        $("#Detalle_Quantity").focus(function() {
            $(this).select();
        });

        $("#Detalle_Discount").focus(function() {
            $(this).select();
        });

        $("#btnAgregarProducto").click(function() {
            if (detalleEnEdicion) {
                actualizarDetalle();
            }
            else {
                agregarProducto();
            }
        });

        $("#cboCliente").change(function() {
            const customerId = $(this).val();
            obtenerUltimaInformacionEnvio(customerId, function(data) {
                actualizarEncabezado(function() {
                    aplicarInformacionEnvio(data);
                });
            });
        });

        $(document).on("click", ".btnEliminar", function() {
            const productID = Number($(this).data("product-id"));
            const rowVersion = $(this).data("row-version");
            eliminarProducto(productID, rowVersion);
        });

        $(document).on("click", ".btnEditar", function() {
            const productID =
                Number($(this).data("product-id"));
            const rowVersion =
                $(this).data("row-version");
            editarProducto(
                productID,
                rowVersion
            );
        });

        $("#btnCancelarEdicion").click(function() {
            salirModoEdicion();
        });

        $("#frmVenta").on("submit", function(e) {
            // Existe un producto seleccionado que no se ha agregado
            if ($("#cboProducto").val() != "") {
                e.preventDefault();
                e.stopImmediatePropagation();
                alert("Se ha seleccionado un producto y no lo ha agregado a la venta.");
                $("#Detalle_Quantity").focus();
                return false;
            }
            // Validaciones de jQuery Validate
            if (!$(this).valid()) {
                e.preventDefault();
                e.stopImmediatePropagation();
                return false;
            }
            // Debe existir al menos un producto
            if ($("#tblDetalle tr").length === 0) {
                e.preventDefault();
                e.stopImmediatePropagation();
                alert("Debe agregar al menos un producto.");
                return false;
            }
            // Mostrar overlay solamente para Generar venta y Nota remisión
            if (botonSubmit === "btnGenerarVenta" ||
                botonSubmit === "btnNotaRemision") {
                mostrarLoadingOverlay();
            }            // Todas las validaciones pasaron
            return true;
        });

        document.addEventListener("DOMContentLoaded", function() {
            const btn = document.getElementById("btnNotaRemision");
            if (btn) {
                btn.addEventListener("click", function() {
                    const url = this.dataset.url;
                    openCenteredPopup(
                        url,
                        "NotaRemision",
                        900,
                        700
                    );
                });
            }
        });

        $("#VentaVM_Freight").focus(function() {
            $(this).select();
        });


        // Registrar qué botón envió el formulario
        let botonSubmit = null;

        $("#btnGenerarVenta, #btnNotaRemision, #btnNuevaVenta").on("click", function() {
            botonSubmit = this.id;
        });


        var detalleVenta = @Html.Raw(Model.DetallesJson);
        if (detalleVenta.length > 0) {
            llenarTabla(detalleVenta);
        }
        mostrarTotales(@Html.Raw(Model.TotalesJson));

    </script>
}
