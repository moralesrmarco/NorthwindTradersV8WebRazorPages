        function actualizarEncabezado(alTerminar) {
            const request = {
                OrderID: parseInt($("#VentaVM_OrderID").val()),
                CustomerID: $("#cboCliente").val(),
                EmployeeID: parseInt($("#cboVendedor").val()),
                OrderDate: $("#VentaVM_OrderDate").val() || null,
                OrderTime: $("#VentaVM_OrderTime").val() || null,
                RequiredDate: $("#VentaVM_RequiredDate").val() || null,
                RequiredTime: $("#VentaVM_RequiredTime").val() || null,
                ShippedDate: $("#VentaVM_ShippedDate").val() || null,
                ShippedTime: $("#VentaVM_ShippedTime").val() || null,
                RowVersion: $("#VentaVM_RowVersion").val()
            };
            $.ajax({
                url: "?handler=ActualizarEncabezado",
                type: "POST",
                contentType: "application/json",
                headers: {
                    "RequestVerificationToken":
                        $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify(request),
                success: function(response) {
                    if (response.ok) {
                        limpiarErrorValidacion();
                        //Actualizar la nueva RowVersion
                        $("#VentaVM_RowVersion").val(response.rowVersion);
                        if (alTerminar) {
                            alTerminar();
                        }
                    } else {
                        mostrarErrorValidacion(response.mensaje);
                        if (
                            response.codigo === -1 ||
                            response.codigo === -2 ||
                            response.codigo === -99
                        ) {
                            bloquearEdicionPorConcurrencia();
                        }
                    }
                },
                error: function(xhr) {
                    mostrarErrorValidacion("Error al actualizar el encabezado.");
                    console.error(xhr);
                }
            });
        }

