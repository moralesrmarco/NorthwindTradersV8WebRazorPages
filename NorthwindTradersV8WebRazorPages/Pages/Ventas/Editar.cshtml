        function eliminarProducto(indice) {
            if (!confirm("¿Desea eliminar este producto de la venta?"))
                return;
            $.ajax({
                url: "?handler=EliminarDetalle",
                type: "POST",
                contentType: "application/json",
                headers: {
                    "RequestVerificationToken":
                        $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify(indice),
                success: function(r) {
                    llenarTabla(r.lista);
                    mostrarTotales(r.totales);
                    if (r.lista.length == 0) {
                        limpiarCapturaProducto();
                    }
                },
                error: function(xhr) {
                    alert(xhr.responseText);
                }
            });
        }

        function editarProducto(indice) {
            $.ajax({
                url: "?handler=EditarDetalle",
                type: "POST",
                contentType: "application/json",
                headers: {
                    "RequestVerificationToken":
                        $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify(indice),
                success: function(r) {
                    llenarTabla(r.lista);
                    mostrarTotales(r.totales);
                    // Cargar nuevamente la captura
                    $("#cboCategoria").val(r.detalle.categoriaID);
                    cargarProductos(
                        r.detalle.categoriaID,
                        r.detalle.productID
                    );
                    $("#Detalle_UnitPrice").val(r.detalle.unitPrice);
                    $("#Detalle_UnitsInStock").val(r.detalle.unitsInStock);
                    $("#Detalle_Quantity").val(r.detalle.quantity);
                    $("#Detalle_Discount").val(r.detalle.discount * 100);
                    calcularDetalle();
                    $("#Detalle_Quantity").focus().select();
                },
                error: function(xhr) {
                    alert(xhr.responseText);
                }
            });
        }

