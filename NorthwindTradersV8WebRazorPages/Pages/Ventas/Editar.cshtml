@page "{id:int}"
@model NorthwindTradersV8WebRazorPages.Pages.Ventas.EditarModel
@{
    ViewData["Title"] = "Editar venta";
}
<h2>@ViewData["Title"]</h2>
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}
<form method="post" id="frmVenta" class="form">
    <div id="validationSummary"
         class="alert alert-danger"
         style="display:none">
    </div>
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@Html.Raw(TempData["Error"])</div>
    }
    @Html.AntiForgeryToken()
    <fieldset class="border rounded p-3 mb-3">
        <legend class="float-none w-auto px-2 fs-6">
            <strong>Registro de la venta</strong>
        </legend>
        <div class="row mb-3">
            <div class="col-md-2">
                <label asp-for="VentaVM.OrderID" class="form-label">ID de la venta</label>
                <input asp-for="VentaVM.OrderID" class="form-control" readonly />
            </div>
            <div class="col-md-5">
                <label asp-for="VentaVM.CustomerID" class="form-label">Cliente</label>
                <select id="cboCliente" asp-for="VentaVM.CustomerID"
                        asp-items="Model.Clientes"
                        class="form-select" 
                        disabled="@Model.BloquearEdicion">
                </select>
                <span asp-validation-for="VentaVM.CustomerID" class="text-danger"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="VentaVM.EmployeeID" class="form-label">Vendedor</label>
                <select id="cboVendedor" asp-for="VentaVM.EmployeeID"
                        asp-items="Model.Vendedores"
                        class="form-select"
                        disabled="@Model.BloquearEdicion">
                </select>
                <span asp-validation-for="VentaVM.EmployeeID" class="text-danger"></span>
            </div>
        </div>
        @if (Model.VentaTieneDetalles)
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i>
                <strong>Fecha de venta bloqueada.</strong>
                La fecha y hora de la venta no pueden modificarse porque ya existen
                detalles asociados. La fecha de la venta determina la tasa de IVA
                aplicada a los productos.
            </div>
        }
        <div class="row mb-3">
            <div class="col-md-2">
                <label>Fecha de venta</label>
                <input asp-for="VentaVM.OrderDate" type="date" class="form-control" disabled="@(Model.BloquearEdicion || Model.VentaTieneDetalles)" />
            </div>
            <div class="col-md-2">
                <label>Hora</label>
                <input type="time"
                       id="VentaVM_OrderTime"
                       name="VentaVM.OrderTime"
                       value="@(Model.VentaVM.OrderTime?.ToString(@"hh\:mm"))"
                       step="60"
                       class="form-control" disabled="@(Model.BloquearEdicion || Model.VentaTieneDetalles)" />
            </div>
            <div class="col-md-2">
                <label>Fecha requerido</label>
                <input asp-for="VentaVM.RequiredDate" type="date" class="form-control" disabled="@Model.BloquearEdicion" />
            </div>
            <div class="col-md-2">
                <label>Hora</label>
                <input type="time"
                       id="VentaVM_RequiredTime"
                       name="VentaVM.RequiredTime"
                       value="@(Model.VentaVM.RequiredTime?.ToString(@"hh\:mm"))"
                       step="60"
                       class="form-control" disabled="@Model.BloquearEdicion" />
            </div>
            <div class="col-md-2">
                <label>Fecha de envío</label>
                <input asp-for="VentaVM.ShippedDate" type="date" class="form-control" disabled="@Model.BloquearEdicion" />
            </div>
            <div class="col-md-2">
                <label>Hora</label>
                <input type="time"
                       id="VentaVM_ShippedTime"
                       name="VentaVM.ShippedTime"
                       value="@(Model.VentaVM.ShippedTime?.ToString(@"hh\:mm"))"
                       step="60"
                       class="form-control" disabled="@Model.BloquearEdicion" />
            </div>
        </div>
        <fieldset class="border rounded p-3 mb-3">
            <legend class="float-none w-auto px-2 fs-6">
                <strong>Forma de envío:</strong>
            </legend>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="VentaVM.ShipVia" class="form-label">Compañía transportista</label>
                    <select id="cboCompañia" asp-for="VentaVM.ShipVia"
                            asp-items="Model.Transportistas"
                            class="form-select" disabled="@Model.BloquearEdicion">
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="VentaVM.ShipName" class="form-label">Enviar a</label>
                    <input asp-for="VentaVM.ShipName" class="form-control" disabled="@Model.BloquearEdicion" />
                </div>
                <div class="col-md-4">
                    <label asp-for="VentaVM.ShipAddress" class="form-label">Domicilio</label>
                    <input asp-for="VentaVM.ShipAddress" class="form-control" disabled="@Model.BloquearEdicion" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="VentaVM.ShipCity" class="form-label">Ciudad</label>
                    <input asp-for="VentaVM.ShipCity" class="form-control" disabled="@Model.BloquearEdicion" />
                </div>
                <div class="col-md-4">
                    <label asp-for="VentaVM.ShipRegion" class="form-label">Región</label>
                    <input asp-for="VentaVM.ShipRegion" class="form-control" disabled="@Model.BloquearEdicion" />
                </div>
                <div class="col-md-4">
                    <label asp-for="VentaVM.ShipPostalCode" class="form-label">Código postal</label>
                    <input asp-for="VentaVM.ShipPostalCode" class="form-control" disabled="@Model.BloquearEdicion" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="VentaVM.ShipCountry" class="form-label">País</label>
                    <input asp-for="VentaVM.ShipCountry" class="form-control" disabled="@Model.BloquearEdicion" />
                </div>
                <div class="col-md-4">
                    <label asp-for="VentaVM.Freight" class="form-label">Cargo por envío $</label>
                    <input asp-for="VentaVM.Freight"
                           class="form-control"
                           type="number"
                           step="1"
                           min="0"
                           disabled="@Model.BloquearEdicion" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="button"
                            id="btnLimpiarEnvio"
                            class="btn btn-sm btn-warning"
                            title="Limpiar forma de envío"
                            disabled="@Model.BloquearEdicion">
                        <i class="bi bi-eraser"></i>
                        <span class="d-none d-md-inline">Limpiar forma de envío</span>
                    </button>
                    &nbsp;&nbsp;
                    <button type="button"
                            id="btnSeleccionarEnvio"
                            class="btn btn-sm btn-primary"
                            title="Seleccionar forma de envío"
                            disabled="@Model.BloquearEdicion">
                        <i class="bi bi-check-square"></i>
                        <span class="d-none d-md-inline">Seleccionar forma de envío</span>
                    </button>
                </div>
            </div>
        </fieldset>
        <fieldset class="border rounded p-3 mb-3">
            <legend class="float-none w-auto px-2 fs-6">
                <strong>Agregar producto a la venta:</strong>
            </legend>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Detalle.CategoriaID" class="form-label">Categoría</label>
                    <select id="cboCategoria" asp-for="Detalle.CategoriaID"
                            asp-items="Model.Categorias"
                            class="form-select" disabled="@Model.BloquearEdicion">
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Detalle.ProductID" class="form-label">Producto</label>
                    <select id="cboProducto" asp-for="Detalle.ProductID"
                            asp-items="Model.Productos"
                            class="form-select" disabled="@Model.BloquearEdicion">
                    </select>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Detalle.UnitPrice" class="form-label flex-grow-1"><strong>Precio $</strong><br /><small class="text-muted">(con impuesto incluido)</small></label>
                    <input asp-for="Detalle.UnitPrice" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Detalle.UnitsInStock" class="form-label flex-grow-1"><strong>Unidades en inventario</strong></label>
                    <input asp-for="Detalle.UnitsInStock" class="form-control" readonly />
                </div>
                <div class="col-md-2 d-flex flex-column">
                    <label asp-for="Detalle.Quantity" class="form-label flex-grow-1">Cantidad</label>
                    <input asp-for="Detalle.Quantity" class="form-control" disabled="@Model.BloquearEdicion" />
                </div>
                <div class="col-md-2 d-flex flex-column">
                    <label asp-for="Detalle.Discount" class="form-label flex-grow-1">Descuento (%)</label>
                    <input asp-for="Detalle.Discount"
                           class="form-control"
                           type="number"
                           step="1"
                           min="0"
                           max="95.00" disabled="@Model.BloquearEdicion" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button"
                            id="btnAgregarProducto"
                            class="btn btn-sm btn-primary"
                            title="Agregar"
                            disabled="@Model.BloquearEdicion">
                        <i class="bi bi-plus-lg"></i>
                        <span class="d-none d-md-inline"> Agregar</span>
                    </button>
                    <button type="button"
                            id="btnCancelarEdicion"
                            class="btn btn-sm btn-secondary ms-2 d-none"
                            title="Cancelar edición"
                            disabled="@Model.BloquearEdicion">
                        <i class="bi bi-x-circle"></i>
                        <span class="d-none d-md-inline"> Cancelar</span>
                    </button>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 d-flex flex-column">
                    <label for="Detalle_PrecioPorUnidadSinIVASinDescuento" class="form-label flex-grow-1">Precio p/u $<br /><small class="text-muted">(sin impuesto incluido antes del descuento)</small></label>
                    <input id="Detalle_PrecioPorUnidadSinIVASinDescuento" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label for="Detalle_IVADelPrecioPorUnidadSinDescuento" class="form-label flex-grow-1">Impuesto incluido p/u $ <br /><small class="text-muted">(antes del descuento)</small></label>
                    <input id="Detalle_IVADelPrecioPorUnidadSinDescuento" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label for="Detalle_PrecioPorUnidadSinIVADespuesDescuento" class="form-label flex-grow-1">Precio p/u $ <br /><small class="text-muted">(sin impuesto incluido despues del descuento)</small></label>
                    <input id="Detalle_PrecioPorUnidadSinIVADespuesDescuento" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label for="Detalle_IVADelPrecioporUnidadDespuesDescuento" class="form-label flex-grow-1">Impuesto p/u $ <br /><small class="text-muted">(despues del descuento)</small></label>
                    <input id="Detalle_IVADelPrecioporUnidadDespuesDescuento" class="form-control" readonly />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 d-flex flex-column">
                    <label for="Detalle_AhorroPorUnidadSinIVA" class="form-label flex-grow-1">Ahorro p/u $ <br /><small class="text-muted">(Sin impuesto despues del descuento)</small></label>
                    <input id="Detalle_AhorroPorUnidadSinIVA" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label for="Detalle_AhorroEnIVAPorUnidadDespuesDescuento" class="form-label flex-grow-1">Ahorro en impuesto p/u $ <br /><small class="text-muted">(despues del descuento)</small></label>
                    <input id="Detalle_AhorroEnIVAPorUnidadDespuesDescuento" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label for="Detalle_AhorroTotalPorUnidadConIVA" class="form-label flex-grow-1">Ahorro total p/u $ <br /><small class="text-muted">(con impuesto despues del descuento)</small></label>
                    <input id="Detalle_AhorroTotalPorUnidadConIVA" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label for="Detalle_PrecioPorUnidadConIVADespuesDescuento" class="form-label flex-grow-1">Precio p/u $ <br /><small class="text-muted">(con impuesto incluido despues del descuento)</small></label>
                    <input id="Detalle_PrecioPorUnidadConIVADespuesDescuento" class="form-control" readonly />
                </div>
            </div>
            <fieldset class="border rounded p-3 mb-3">
                <legend class="float-none w-auto px-2 fs-6">
                    <strong>Subtotales de la venta del producto:</strong>
                </legend>
                <div class="row mb-3">
                    <div class="col-md-3 d-flex flex-column">
                        <label for="Detalle_SubtotalDelImporteConIVAIncluido" class="form-label flex-grow-1">Subtotal del importe $ <br /><small class="text-muted">(Precio con impuesto incluido)</small></label>
                        <input id="Detalle_SubtotalDelImporteConIVAIncluido" class="form-control" readonly />
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label for="Detalle_SubtotalDelImporteSinIVASinDescuento" class="form-label flex-grow-1">Subtotal del importe sin impuesto antes del descuento $ <br /><small class="text-muted">(Precio sin impuesto incluido antes del descuento)</small></label>
                        <input id="Detalle_SubtotalDelImporteSinIVASinDescuento" class="form-control" readonly />
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label for="Detalle_SubtotalDelImporteDelIVASinDescuento" class="form-label flex-grow-1">Subtotal del impuesto incluido $ <br /><small class="text-muted">(Antes del descuento)</small></label>
                        <input id="Detalle_SubtotalDelImporteDelIVASinDescuento" class="form-control" readonly />
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label for="Detalle_SubtotalDelImporteSinIVAConDescuento" class="form-label flex-grow-1">Subtotal del importe sin impuesto despues del descuento $ <br /><small class="text-muted">(Precio sin impuesto incluido despues del descuento)</small></label>
                        <input id="Detalle_SubtotalDelImporteSinIVAConDescuento" class="form-control" readonly />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-3 d-flex flex-column">
                        <label for="Detalle_SubtotalIVADespuesDelDescuento" class="form-label flex-grow-1">Subtotal del impuesto despues del descuento $</label>
                        <input id="Detalle_SubtotalIVADespuesDelDescuento" class="form-control" readonly />
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label for="Detalle_SubtotalDelAhorroSinIvaDespuesDescuento" class="form-label flex-grow-1">Subtotal del ahorro sin impuesto $ <br /><small class="text-muted">(despues del descuento)</small></label>
                        <input id="Detalle_SubtotalDelAhorroSinIvaDespuesDescuento" class="form-control" readonly />
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label for="Detalle_SubtotalDelAhorroEnIVADespuesDescuento" class="form-label flex-grow-1">Subtotal del ahorro en impuesto $ <br /><small class="text-muted">(despues del descuento)</small></label>
                        <input id="Detalle_SubtotalDelAhorroEnIVADespuesDescuento" class="form-control" readonly />
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label for="Detalle_SubtotalDelAhorroTotalDespuesDescuento" class="form-label flex-grow-1">Subtotal del ahorro total $ <br /><small class="text-muted">(despues del descuento)</small></label>
                        <input id="Detalle_SubtotalDelAhorroTotalDespuesDescuento" class="form-control" readonly />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-3 d-flex flex-column">
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label for="Detalle_Subtotal" class="form-label flex-grow-1"><strong>Total del producto $</strong></label>
                        <input id="Detalle_Subtotal" class="form-control" readonly />
                    </div>
                </div>
            </fieldset>
        </fieldset>
        <fieldset class="border rounded p-3 mb-3">
            <legend class="float-none w-auto px-2 fs-6">
                <strong>Detalle de la venta:</strong>
            </legend>
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped align-middle" style="font-size:0.75rem;">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center">N°</th>
                            <th class="text-center">Producto</th>
                            <th class="text-center">Precio <br /><small class="text-muted">(con impuesto incluido)</small></th>
                            <th class="text-center">Cantidad</th>
                            <th class="text-center">Importe</th>
                            <th class="text-center">Desc.</th>
                            <th class="text-center">Importe del descuento</th>
                            <th class="text-center">Importe con descuento</th>
                            <th class="text-center">Tasa impuesto</th>
                            <th class="text-center">Importe sin impuesto</th>
                            <th class="text-center">Importe del impuesto <br /><small class="text-muted">(incluido)</small></th>
                            <th class="text-center">Subtotal</th>
                            <th class="text-center" width="120">Acciones</th>
                            <th class="d-none"></th>
                        </tr>
                    </thead>
                    <tbody id="tblDetalle">
                    </tbody>
                </table>
            </div>
        </fieldset>
        <fieldset class="border rounded p-3 mb-3">
            <legend class="float-none w-auto px-2 fs-6">
                <strong>Totales de la venta:</strong>
            </legend>
            <div class="row mb-3">
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Totales.NumeroProductos" class="form-label flex-grow-1">Número de productos</label>
                    <input asp-for="Totales.NumeroProductos" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Totales.TotalUnidades" class="form-label flex-grow-1">Total de unidades</label>
                    <input asp-for="Totales.TotalUnidades" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Totales.TotalImporteConIVA" class="form-label flex-grow-1">Subtotal del importe $ <br /><small class="text-muted">(precio con impuesto incluido)</small></label>
                    <input asp-for="Totales.TotalImporteConIVA" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Totales.TotalDescuento" class="form-label flex-grow-1">Subtotal del importe del descuento $</label>
                    <input asp-for="Totales.TotalDescuento" class="form-control" readonly />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Totales.TotalImporteConDescuento" class="form-label flex-grow-1">Subtotal del importe con descuento $</label>
                    <input asp-for="Totales.TotalImporteConDescuento" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Totales.TotalImporteSinIVA" class="form-label flex-grow-1">Subtotal del importe sin impuesto $</label>
                    <input asp-for="Totales.TotalImporteSinIVA" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Totales.TotalIVA" class="form-label flex-grow-1">Subtotal del importe del impuesto $ <br /><small class="text-muted">(incluido)</small></label>
                    <input asp-for="Totales.TotalIVA" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Totales.Total" class="form-label flex-grow-1"><strong>Total</strong></label>
                    <input asp-for="Totales.Total" class="form-control" readonly />
                </div>
            </div>
        </fieldset>
        <div class="d-flex justify-content-end gap-2 mb-3">
            <a asp-page="./Insertar"
               id="btnNuevaVenta"
               class="btn btn-sm btn-primary"
               title="Nueva venta">
                <i class="bi bi-file-earmark-plus"></i>
                <span class="d-none d-md-inline"> Nueva venta</span>
            </a>
            <button type="button"
                    id="btnNotaRemision"
                    class="btn btn-sm btn-warning"
                    title="Nota de remisión"
                    disabled="@(!Model.VentaGuardada)"
                    data-url="@Url.Page(
                                                    "/Ventas/Reportes/NotaRemisionRpt",
                                                    pageHandler: "Pdf",
                                                    values: new { orderId = Model.OrderID })">
                <i class="bi bi-printer"></i>
                <span class="d-none d-md-inline">Nota de remisión</span>
            </button>
            <a href="@(Model.ReturnUrl ?? Url.Page("Index"))"
               class="btn btn-sm btn-cancelar"
               title="Cancelar">
                <i class="bi bi-x-circle"></i>
                <span class="d-none d-md-inline"> Cancelar</span>
            </a>
        </div>
    </fieldset>
    <input asp-for="OrderID" type="hidden" />
    <input asp-for="VentaVM.RowVersion" type="hidden" />
    <input type="hidden"
           asp-for="VentaVM.TasaIVA"
           id="VentaVM_TasaIVA" />
</form>
<div class="modal fade"
     id="modalFormasEnvio"
     tabindex="-1"
     aria-labelledby="modalFormasEnvioLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalFormasEnvioLabel">
                    Seleccionar forma de envío
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table id="tblFormasEnvio"
                           class="table table-bordered table-hover table-striped align-middle"
                           style="font-size:0.65rem;">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center">Compañía transportista</th>
                                <th class="text-center">Enviar a</th>
                                <th class="text-center">Domicilio</th>
                                <th class="text-center">Ciudad</th>
                                <th class="text-center">Región</th>
                                <th class="text-center">Código postal</th>
                                <th class="text-center">País</th>
                                <th class="d-none"></th>
                                <th class="text-center" width="100">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyFormasEnvio">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>
        </div>
    </div>      
</div>
@section Scripts {
    <script>
        function mostrarErrorValidacion(mensaje) {
            const summary = $("#validationSummary");
            summary
                .html("<ul><li>" + mensaje + "</li></ul>")
                .show();
            // Desplazar la página hacia el elemento de resumen de validación
            try {
                var top = summary.offset() ? summary.offset().top : 0;
                // Dejar un pequeño espacio por encima
                $("html, body").animate({ scrollTop: Math.max(top - 10, 0) }, 400);
            } catch (e) {
                // En caso de error (ej. summary no existe), hacer scroll al inicio
                $("html, body").animate({ scrollTop: 0 }, 400);
            }
        }

