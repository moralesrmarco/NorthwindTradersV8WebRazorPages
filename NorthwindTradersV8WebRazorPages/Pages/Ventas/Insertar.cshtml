@page
@using System.Globalization
@model NorthwindTradersV8WebRazorPages.Pages.Ventas.InsertarModel
@{
    ViewData["Title"] = "Insertar venta";
}
<h2>Nueva venta</h2>

<form method="post" class="form">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@Html.Raw(TempData["Error"])</div>
    }
    @Html.AntiForgeryToken()
    <fieldset class="border rounded p-3 mb-3">
        <legend class="float-none w-auto px-2 fs-6">
            <strong>Registro de la venta</strong>
        </legend>
        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="VentaVM.CustomerID" class="form-label">Cliente</label>
                <select id="cboCliente" asp-for="VentaVM.CustomerID"
                        asp-items="Model.Clientes"
                        class="form-select">
                </select>
                <span asp-validation-for="VentaVM.CustomerID" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="VentaVM.EmployeeID" class="form-label">Vendedor</label>
                <select id="cboVendedor" asp-for="VentaVM.EmployeeID"
                        asp-items="Model.Vendedores"
                        class="form-select">
                </select>
                <span asp-validation-for="VentaVM.EmployeeID" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-4">
                <label asp-for="VentaVM.OrderDate" class="form-label">Fecha de venta</label>
                <input asp-for="VentaVM.OrderDate" class="form-control" type="date" />
                <span asp-validation-for="VentaVM.OrderDate" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="VentaVM.RequiredDate" class="form-label">Fecha requerido</label>
                <input asp-for="VentaVM.RequiredDate" class="form-control" type="date" />
                <span asp-validation-for="VentaVM.RequiredDate" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="VentaVM.ShippedDate" class="form-label">Fecha de envío</label>
                <input asp-for="VentaVM.ShippedDate" class="form-control" type="date" />
                <span asp-validation-for="VentaVM.ShippedDate" class="text-danger"></span>
            </div>
        </div>
        <fieldset class="border rounded p-3 mb-3">
            <legend class="float-none w-auto px-2 fs-6">
                <strong>Forma de envío:</strong>
            </legend>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="VentaVM.ShipVia" class="form-label">Compañía transportista</label>
                    <select id="cboCompañia" asp-for="VentaVM.ShipVia"
                            asp-items="Model.Transportistas"
                            class="form-select">
                    </select>
                    <span asp-validation-for="VentaVM.ShipVia" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="VentaVM.ShipName" class="form-label">Enviar a</label>
                    <input asp-for="VentaVM.ShipName" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="VentaVM.ShipAddress" class="form-label">Domicilio</label>
                    <input asp-for="VentaVM.ShipAddress" class="form-control" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="VentaVM.ShipCity" class="form-label">Ciudad</label>
                    <input asp-for="VentaVM.ShipCity" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="VentaVM.ShipRegion" class="form-label">Región</label>
                    <input asp-for="VentaVM.ShipRegion" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="VentaVM.ShipPostalCode" class="form-label">Código postal</label>
                    <input asp-for="VentaVM.ShipPostalCode" class="form-control" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="VentaVM.ShipCountry" class="form-label">País</label>
                    <input asp-for="VentaVM.ShipCountry" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="VentaVM.Freight" class="form-label">Cargo por envío $</label>
                    <input asp-for="VentaVM.Freight" class="form-control" />
                </div>
            </div>
        </fieldset>
        <fieldset class="border rounded p-3 mb-3">
            <legend class="float-none w-auto px-2 fs-6">
                <strong>Agregar producto a la venta:</strong>
            </legend>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Detalle.CategoriaID" class="form-label">Categoría</label>
                    <select id="cboCategoria" asp-for="Detalle.CategoriaID"
                            asp-items="Model.Categorias"
                            class="form-select">
                    </select>
                    <span asp-validation-for="Detalle.CategoriaID" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Detalle.ProductID" class="form-label">Producto</label>
                    <select id="cboProducto" asp-for="Detalle.ProductID"
                            asp-items="Model.Productos"
                            class="form-select">
                    </select>
                    <span asp-validation-for="Detalle.ProductID" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Detalle.UnitPrice" class="form-label flex-grow-1"><strong>Precio $</strong><br /><small class="text-muted">(con IVA incluido)</small></label>
                    <input asp-for="Detalle.UnitPrice" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Detalle.UnitsInStock" class="form-label flex-grow-1"><strong>Unidades en inventario</strong></label>
                    <input asp-for="Detalle.UnitsInStock" class="form-control" readonly />
                
                </div>
                <div class="col-md-2 d-flex flex-column">
                    <label asp-for="Detalle.Quantity" class="form-label flex-grow-1">Cantidad</label>
                    <input asp-for="Detalle.Quantity" class="form-control" />
                    <span asp-validation-for="Detalle.Quantity" class="text-danger"></span>
                </div>
                <div class="col-md-2 d-flex flex-column">
                    <label asp-for="Detalle.Discount" class="form-label flex-grow-1">Descuento (%)</label>
                    <input asp-for="Detalle.Discount" class="form-control" placeholder="Ejemplo: 10%" />
                    <span asp-validation-for="Detalle.Discount" class="text-danger"></span>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit"
                            asp-page-handler="AgregarProducto"
                            class="btn btn-primary"
                            title="Agregar">
                        <i class="bi bi-plus-lg"></i>
                        <span class="d-none d-md-inline"> Agregar</span>
                    </button>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Detalle.PrecioPorUnidadSinIVASinDescuento" class="form-label flex-grow-1">Precio p/u $<br /><small class="text-muted">(sin IVA incluido antes del descuento)</small></label>
                    <input asp-for="Detalle.PrecioPorUnidadSinIVASinDescuento" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Detalle.IVADelPrecioPorUnidadSinDescuento" class="form-label flex-grow-1">IVA incluido p/u $ <br /><small class="text-muted">(antes del descuento)</small></label>
                    <input asp-for="Detalle.IVADelPrecioPorUnidadSinDescuento" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Detalle.PrecioPorUnidadSinIVADespuesDescuento" class="form-label flex-grow-1">Precio p/u $ <br /><small class="text-muted">(sin IVA incluido despues del descuento)</small></label>
                    <input asp-for="Detalle.PrecioPorUnidadSinIVADespuesDescuento" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Detalle.IVADelPrecioporUnidadDespuesDescuento" class="form-label flex-grow-1">IVA p/u $ <br /><small class="text-muted">(despues del descuento)</small></label>
                    <input asp-for="Detalle.IVADelPrecioporUnidadDespuesDescuento" class="form-control" readonly />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Detalle.AhorroPorUnidadSinIVA" class="form-label flex-grow-1">Ahorro p/u $ <br /><small class="text-muted">(Sin IVA despues del descuento)</small></label>
                    <input asp-for="Detalle.AhorroPorUnidadSinIVA" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Detalle.AhorroEnIVAPorUnidadDespuesDescuento" class="form-label flex-grow-1">Ahorro en IVA p/u $ <br /><small class="text-muted">(despues del descuento)</small></label>
                    <input asp-for="Detalle.AhorroEnIVAPorUnidadDespuesDescuento" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Detalle.AhorroTotalPorUnidadConIVA" class="form-label flex-grow-1">Ahorro total p/u $ <br /><small class="text-muted">(con IVA despues del descuento)</small></label>
                    <input asp-for="Detalle.AhorroTotalPorUnidadConIVA" class="form-control" readonly />
                </div>
                <div class="col-md-3 d-flex flex-column">
                    <label asp-for="Detalle.PrecioPorUnidadConIVADespuesDescuento" class="form-label flex-grow-1">Precio p/u $ <br /><small class="text-muted">(con IVA incluido despues del descuento)</small></label>
                    <input asp-for="Detalle.PrecioPorUnidadConIVADespuesDescuento" class="form-control" readonly />
                </div>
            </div>
            <fieldset class="border rounded p-3 mb-3">
                <legend class="float-none w-auto px-2 fs-6">
                    <strong>Subtotales de la venta del producto:</strong>
                </legend>
                <div class="row mb-3">
                    <div class="col-md-3 d-flex flex-column">
                        <label asp-for="Detalle.SubtotalDelImporteConIVAIncluido" class="form-label flex-grow-1">Subtotal del importe $ <br /><small class="text-muted">(Precio con IVA incluido)</small></label>
                        <input asp-for="Detalle.SubtotalDelImporteConIVAIncluido" class="form-control" readonly />
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label asp-for="Detalle.SubtotalDelImporteSinIVASinDescuento" class="form-label flex-grow-1">Subtotal del importe sin IVA antes del descuento $ <br /><small class="text-muted">(Precio sin IVA incluido antes del descuento)</small></label>
                        <input asp-for="Detalle.SubtotalDelImporteSinIVASinDescuento" class="form-control" readonly />
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label asp-for="Detalle.SubtotalDelImporteDelIVASinDescuento" class="form-label flex-grow-1">Subtotal del IVA incluido $ <br /><small class="text-muted">(Antes del descuento)</small></label>
                        <input asp-for="Detalle.SubtotalDelImporteDelIVASinDescuento" class="form-control" readonly />
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label asp-for="Detalle.SubtotalDelImporteSinIVAConDescuento" class="form-label flex-grow-1">Subtotal del importe sin IVA despues del descuento $ <br /><small class="text-muted">(Precio sin IVA incluido despues del descuento)</small></label>
                        <input asp-for="Detalle.SubtotalDelImporteSinIVAConDescuento" class="form-control" readonly />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-3 d-flex flex-column">
                        <label asp-for="Detalle.SubtotalIVADespuesDelDescuento" class="form-label flex-grow-1">Subtotal del IVA despues del descuento $</label>
                        <input asp-for="Detalle.SubtotalIVADespuesDelDescuento" class="form-control" readonly />
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label asp-for="Detalle.SubtotalDelAhorroSinIvaDespuesDescuento" class="form-label flex-grow-1">Subtotal del ahorro sin IVA $ <br /><small class="text-muted">(despues del descuento)</small></label>
                        <input asp-for="Detalle.SubtotalDelAhorroSinIvaDespuesDescuento" class="form-control" readonly />
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label asp-for="Detalle.SubtotalDelAhorroEnIVADespuesDescuento" class="form-label flex-grow-1">Subtotal del ahorro en IVA $ <br /><small class="text-muted">(despues del descuento)</small></label>
                        <input asp-for="Detalle.SubtotalDelAhorroEnIVADespuesDescuento" class="form-control" readonly />
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label asp-for="Detalle.SubtotalDelAhorroTotalDespuesDescuento" class="form-label flex-grow-1">Subtotal del ahorro total $ <br /><small class="text-muted">(despues del descuento)</small></label>
                        <input asp-for="Detalle.SubtotalDelAhorroTotalDespuesDescuento" class="form-control" readonly />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-3 d-flex flex-column">
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label asp-for="Detalle.Subtotal" class="form-label flex-grow-1"><strong>Total del producto $</strong></label>
                        <input asp-for="Detalle.Subtotal" class="form-control" readonly />
                    </div>
                </div>
            </fieldset>
            <fieldset class="border rounded p-3 mb-3">
                <legend class="float-none w-auto px-2 fs-6">
                    <strong>Totales de la venta:</strong>
                </legend>
                <div class="row mb-3">
                    <div class="col-md-3 d-flex flex-column">
                        <label asp-for="Detalle.SubtotalDelImporteConIVAIncluido" class="form-label flex-grow-1">Número de productos</label>
                        <input asp-for="Detalle.SubtotalDelImporteConIVAIncluido" class="form-control" readonly />
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label asp-for="Detalle.SubtotalDelImporteSinIVASinDescuento" class="form-label flex-grow-1">Total de unidades</label>
                        <input asp-for="Detalle.SubtotalDelImporteSinIVASinDescuento" class="form-control" readonly />
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label asp-for="Detalle.SubtotalDelImporteDelIVASinDescuento" class="form-label flex-grow-1">Subtotal del importe $ <br /><small class="text-muted">(precio con IVA incluido)</small></label>
                        <input asp-for="Detalle.SubtotalDelImporteDelIVASinDescuento" class="form-control" readonly />
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label asp-for="Detalle.SubtotalDelImporteSinIVAConDescuento" class="form-label flex-grow-1">Subtotal del importe del descuento $</label>
                        <input asp-for="Detalle.SubtotalDelImporteSinIVAConDescuento" class="form-control" readonly />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-3 d-flex flex-column">
                        <label asp-for="Detalle.SubtotalIVADespuesDelDescuento" class="form-label flex-grow-1">Subtotal del importe con descuento $</label>
                        <input asp-for="Detalle.SubtotalIVADespuesDelDescuento" class="form-control" readonly />
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label asp-for="Detalle.SubtotalDelAhorroSinIvaDespuesDescuento" class="form-label flex-grow-1">Subtotal del importe sin IVA $</label>
                        <input asp-for="Detalle.SubtotalDelAhorroSinIvaDespuesDescuento" class="form-control" readonly />
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label asp-for="Detalle.SubtotalDelAhorroEnIVADespuesDescuento" class="form-label flex-grow-1">Subtotal del importe del IVA $ <br /><small class="text-muted">(incluido)</small></label>
                        <input asp-for="Detalle.SubtotalDelAhorroEnIVADespuesDescuento" class="form-control" readonly />
                    </div>
                    <div class="col-md-3 d-flex flex-column">
                        <label asp-for="Detalle.SubtotalDelAhorroTotalDespuesDescuento" class="form-label flex-grow-1"><strong>Total</strong></label>
                        <input asp-for="Detalle.SubtotalDelAhorroTotalDespuesDescuento" class="form-control" readonly />
                    </div>
                </div>
            </fieldset>
        </fieldset>
        <fieldset class="border rounded p-3 mb-3">
            <legend class="float-none w-auto px-2 fs-6">
                <strong>Detalle de la venta:</strong>
            </legend>
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class ="text-center">N°</th>
                            <th class="text-center">Producto</th>
                            <th class="text-center">Precio <br /><small class="text-muted">(con IVA incluido)</small></th>
                            <th class="text-center">Cantidad</th>
                            <th class="text-center">Importe</th>
                            <th class="text-center">Desc.</th>
                            <th class="text-center">Importe del descuento</th>
                            <th class="text-center">Importe con descuento</th>
                            <th class="text-center">Tasa IVA</th>
                            <th class="text-center">Importe sin IVA</th>
                            <th class="text-center">Importe del IVA <br /><small class="text-muted">(incluido)</small></th>
                            <th class="text-center">Subtotal</th>
                            <th class="text-center" width="120">Acciones</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Detalles.Count; i++)
                        {
                            <tr>
                                <td class="text-center">@(i + 1)</td>
                                <td>@Model.Detalles[i].ProductName</td>
                                <td class="text-center">
                                    @Model.Detalles[i].UnitPrice.ToString("N2")
                                </td>
                                <td class="text-center">
                                    @Model.Detalles[i].Quantity
                                </td>
                                <td class="text-end">
                                    @Model.Detalles[i].SubtotalDelImporteConIVAIncluido
                                </td>
                                <td class="text-center">
                                    @Model.Detalles[i].Discount.ToString("P2")
                                </td>
                                <td class="text-end">
                                    @Model.Detalles[i].SubtotalDelAhorroTotalDespuesDescuento
                                </td>
                                <td class="text-end">
                                    @Model.Detalles[i].SubtotalDelImporteConIVAConDescuento
                                </td>
                                <td class="text-center">
                                    @Model.Detalles[i].TasaIVA.ToString("P2")
                                </td>
                                <td class="text-end">
                                    @Model.Detalles[i].SubtotalDelImporteSinIVAConDescuento
                                </td>
                                <td class="text-end">
                                    @Model.Detalles[i].SubtotalIVADespuesDelDescuento
                                </td>
                                <td class="text-end fw-bold">
                                    @Model.Detalles[i].Subtotal.ToString("N2")
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                                <td>@Model.Detalles[i].ProductID</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </fieldset>
    </fieldset>
    
</form>
@section Scripts {

    <script>
        function cargarProductos(categoriaId)
        {
            $("#cboProducto").empty();
            // Si el usuario volvió a seleccionar "Seleccione"
            if (categoriaId == "") {
                $("#cboProducto").append(
                    $("<option>")
                        .val("")
                        .text("»--- Seleccione una categoría ---«")
                );
                return;
            } 
            $.getJSON(
                "?handler=ProductosPorCategoria",
                { categoriaId: categoriaId },
                function(data) {
                    $.each(data, function(i, item) {
                        $("#cboProducto").append(
                            $("<option>")
                                .val(item.value)
                                .text(item.text)
                        );
                    });
                });
        }

        function cargarInformacionEnvio(customerId)
        {
            // Si seleccionó "Seleccione"
            if (customerId == "") {
                $("#VentaVM_ShipName").val("");
                $("#VentaVM_ShipAddress").val("");
                $("#VentaVM_ShipCity").val("");
                $("#VentaVM_ShipRegion").val("");
                $("#VentaVM_ShipPostalCode").val("");
                $("#VentaVM_ShipCountry").val("");
                $("#cboCompañia").val("");
                return;
            }
            $.getJSON(
                "?handler=UltimaInformacionEnvio",
                { customerId: customerId },
                function(data) {
                    if (data == null)
                        return;
                    $("#VentaVM_ShipName").val(data.shipName);
                    $("#VentaVM_ShipAddress").val(data.shipAddress);
                    $("#VentaVM_ShipCity").val(data.shipCity);
                    $("#VentaVM_ShipRegion").val(data.shipRegion);
                    $("#VentaVM_ShipPostalCode").val(data.shipPostalCode);
                    $("#VentaVM_ShipCountry").val(data.shipCountry);
                    $("#cboCompañia").val(String(data.shipVia));
                });
        }

        function cargarInformacionProducto(productId) {
            if (productId == "") {
                $("#Detalle_UnitPrice").val("");
                $("#Detalle_UnitsInStock").val("");
                return;
            }
            $.getJSON(
                "?handler=ProductoCostoEInventario",
                { productId: productId },
                function(data) {
                    if (data == null)
                        return;

                    $("#Detalle_UnitPrice").val(data.unitPrice);
                    $("#Detalle_UnitsInStock").val(data.unitsInStock);
                });
        }

        function calcularDetalle() {
            let detalle = {
                unitPrice: Number($("#Detalle_UnitPrice").val()),
                unitsInStock: Number($("#Detalle_UnitsInStock").val()),
                quantity: Number($("#Detalle_Quantity").val()),
                discount: Number($("#Detalle_Discount").val()) / 100
            };
            $.ajax({
                url: "?handler=CalcularDetalle",
                type: "POST",
                contentType: "application/json",
                headers: {
                    "RequestVerificationToken":
                        $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify(detalle),
                success: function(r) {

                    console.log(r);

                    // Datos básicos
                    $("#Detalle_PrecioPorUnidadSinIVASinDescuento")
                        .val(r.precioPorUnidadSinIVASinDescuento);

                    $("#Detalle_IVADelPrecioPorUnidadSinDescuento")
                        .val(r.ivaDelPrecioPorUnidadSinDescuento);

                    $("#Detalle_PrecioPorUnidadSinIVADespuesDescuento")
                        .val(r.precioPorUnidadSinIVADespuesDescuento);

                    $("#Detalle_IVADelPrecioporUnidadDespuesDescuento")
                        .val(r.ivaDelPrecioporUnidadDespuesDescuento);

                    // Ahorros por unidad
                    $("#Detalle_AhorroPorUnidadSinIVA")
                        .val(r.ahorroPorUnidadSinIVA);

                    $("#Detalle_AhorroEnIVAPorUnidadDespuesDescuento")
                        .val(r.ahorroEnIVAPorUnidadDespuesDescuento);

                    $("#Detalle_AhorroTotalPorUnidadConIVA")
                        .val(r.ahorroTotalPorUnidadConIVA);

                    $("#Detalle_PrecioPorUnidadConIVADespuesDescuento")
                        .val(r.precioPorUnidadConIVADespuesDescuento);

                    // Subtotales del producto
                    $("#Detalle_SubtotalDelImporteConIVAIncluido")
                        .val(r.subtotalDelImporteConIVAIncluido);

                    $("#Detalle_SubtotalDelImporteSinIVASinDescuento")
                        .val(r.subtotalDelImporteSinIVASinDescuento);

                    $("#Detalle_SubtotalDelImporteDelIVASinDescuento")
                        .val(r.subtotalDelImporteDelIVASinDescuento);

                    $("#Detalle_SubtotalDelImporteSinIVAConDescuento")
                        .val(r.subtotalDelImporteSinIVAConDescuento);

                    $("#Detalle_SubtotalIVADespuesDelDescuento")
                        .val(r.subtotalIVADespuesDelDescuento);

                    // Ahorros subtotal
                    $("#Detalle_SubtotalDelAhorroSinIvaDespuesDescuento")
                        .val(r.subtotalDelAhorroSinIvaDespuesDescuento);

                    $("#Detalle_SubtotalDelAhorroEnIVADespuesDescuento")
                        .val(r.subtotalDelAhorroEnIVADespuesDescuento);

                    $("#Detalle_SubtotalDelAhorroTotalDespuesDescuento")
                        .val(r.subtotalDelAhorroTotalDespuesDescuento);

                    // Total del producto
                    $("#Detalle_Subtotal")
                        .val(r.subtotal);

                },
                error: function(xhr) {
                    console.log(xhr.responseText);
                }
            });
        }

        $("#cboCategoria").change(function() {
            cargarProductos($(this).val());
        });

        $("#cboCliente").change(function() {
            cargarInformacionEnvio($(this).val());
        });

        $("#cboProducto").change(function() {
            cargarInformacionProducto($(this).val());
        });

        $("#Detalle_Quantity").on("input", calcularDetalle);

        $("#Detalle_Discount").on("input", calcularDetalle);
    </script>

}