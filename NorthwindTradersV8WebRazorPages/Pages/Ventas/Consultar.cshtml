@page
@using System.Globalization
@model NorthwindTradersV8WebRazorPages.Pages.Ventas.ConsultarModel
@{
    ViewData["Title"] = "Consulta de venta";
}
<h2>Detalle de la venta</h2>

<ul class="nav nav-tabs" id="tabs">
    <li class="nav-item">
        <button type="button"
                class="nav-link active"
                data-bs-toggle="tab"
                data-bs-target="#consulta">
            <strong>Consulta de la venta</strong>
        </button>
    </li>
    <li class="nav-item">
        <button type="button"
                class="nav-link"
                data-bs-toggle="tab"
                data-bs-target="#detalle">
            <strong>Detalle de la venta</strong>
        </button>
    </li>
</ul>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@Html.Raw(TempData["Error"])</div>
}
<input type="hidden" asp-for="PestanaActiva" />

<div class="tab-content border border-top-0 p-3">
    <div class="tab-pane fade show active" id="consulta">

        <div class="row mb-3">
            <div class="col-md-2">
                <label asp-for="Venta.OrderID" class="form-label">ID</label>
                <input asp-for="Venta.OrderID" class="form-control" readonly />
            </div>
            <div class="col-md-5">
                <label asp-for="Venta.CustomerCompanyName" class="form-label">Cliente</label>
                <input asp-for="Venta.CustomerCompanyName" class="form-control" readonly />
            </div>
            <div class="col-md-5">
                <label asp-for="Venta.EmployeeName" class="form-label">Vendedor</label>
                <input asp-for="Venta.EmployeeName" class="form-control" readonly />
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-4">
                <label asp-for="Venta.OrderDate" class="form-label">Fecha de venta</label>
                <input class="form-control"
                       value="@Model.Venta?.OrderDate?.ToString("ddd dd 'de' MMM 'de' yyyy HH:mm:ss tt", new CultureInfo("es-MX"))"
                       readonly />
            </div>
            <div class="col-md-4">
                <label asp-for="Venta.RequiredDate" class="form-label">Fecha requerido</label>
                <input class="form-control"
                       value="@Model.Venta?.RequiredDate?.ToString("ddd dd 'de' MMM 'de' yyyy HH:mm:ss tt", new CultureInfo("es-MX"))"
                       readonly />
            </div>
            <div class="col-md-4">
                <label asp-for="Venta.ShippedDate" class="form-label">Fecha de envío</label>
                <input class="form-control"
                       value="@Model.Venta?.ShippedDate?.ToString("ddd dd 'de' MMM 'de' yyyy HH:mm:ss tt", new CultureInfo("es-MX"))"
                       readonly />
            </div>
        </div>
        <fieldset class="border rounded p-3 mb-3">
            <legend class="float-none w-auto px-2 fs-6">
                <strong>Forma de envío:</strong>
            </legend>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="Venta.ShipperCompanyName" class="form-label">Compañía</label>
                    <input asp-for="Venta.ShipperCompanyName" class="form-control" readonly />
                </div>
                <div class="col-md-4">
                    <label asp-for="Venta.ShipName" class="form-label">Enviar a</label>
                    <input asp-for="Venta.ShipName" class="form-control" readonly />
                </div>
                <div class="col-md-4">
                    <label asp-for="Venta.ShipAddress" class="form-label">Domicilio</label>
                    <input asp-for="Venta.ShipAddress" class="form-control" readonly />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="Venta.ShipCity" class="form-label">Ciudad</label>
                    <input asp-for="Venta.ShipCity" class="form-control" readonly />
                </div>
                <div class="col-md-4">
                    <label asp-for="Venta.ShipRegion" class="form-label">Región</label>
                    <input asp-for="Venta.ShipRegion" class="form-control" readonly />
                </div>
                <div class="col-md-4">
                    <label asp-for="Venta.ShipPostalCode" class="form-label">Código postal</label>
                    <input asp-for="Venta.ShipPostalCode" class="form-control" readonly />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="Venta.ShipCountry" class="form-label">País</label>
                    <input asp-for="Venta.ShipCountry" class="form-control" readonly />
                </div>
                <div class="col-md-4">
                    <label asp-for="Venta.Freight" class="form-label">Cargo por envío $</label>
                    <input asp-for="Venta.Freight" class="form-control" readonly />
                </div>
            </div>
        </fieldset>
    </div>
    <div class="tab-pane fade" id="detalle">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th class="text-center">N°</th>
                        <th>Producto</th>
                        <th class="text-center">Precio con IVA incluido</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-center">Importe</th>
                        <th class="text-center">Descuento</th>
                        <th class="text-center">Importe del descuento</th>
                        <th class="text-center">Importe con descuento</th>
                        <th class="text-center">Tasa IVA</th>
                        <th class="text-center">Importe sin IVA</th>
                        <th class="text-center">Importe del IVA (Incluido)</th>
                        <th class="text-center"><strong>Subtotal</strong></th>
                    </tr>
                </thead>
                @{
                    int numDetalle = Model.Venta?.NumeroProductos ?? 0;
                }
                <tbody>
                    @foreach (var detalle in Model.VentaDetalle)
                    {
                        <tr>
                            <td class="text-center">@numDetalle</td>
                            <td>@detalle.ProductName</td>
                            <td class="text-center">@detalle.UnitPrice.ToString("N2")</td>
                            <td class="text-center">@detalle.Quantity.ToString("N0")</td>
                            <td class="text-end">@detalle.SubtotalDelImporteConIVAIncluido.ToString("N2")</td>
                            <td class="text-center">@detalle.Discount.ToString("P2")</td>
                            <td class="text-end">@detalle.SubtotalDelAhorroTotalDespuesDescuento.ToString("N2")</td>
                            <td class="text-end">@detalle.SubtotalDelImporteConIVAConDescuento.ToString("N2")</td>
                            <td class="text-center">@detalle.TasaIVA.ToString("P2")</td>
                            <td class="text-end">@detalle.SubtotalDelImporteSinIVAConDescuento.ToString("N2")</td>
                            <td class="text-end">@detalle.SubtotalIVADespuesDelDescuento.ToString("N2")</td>
                            <td class="text-end"><strong>@detalle.Subtotal.ToString("N2")</strong></td>
                        </tr>
                        numDetalle--;
                    }
                </tbody>
            </table>
        </div>
    </div>
    <fieldset class="border rounded p-3 mb-3">
        <legend class="float-none w-auto px-2 fs-6">
            <strong>Totales de la venta:</strong>
        </legend>
        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Número de productos</label>
                <input class="form-control text-center"
                       value="@($"{Model.Venta?.NumeroProductos:N0}")"
                       readonly />
            </div>
            <div class="col-md-4">
                <label class="form-label">Total de unidades</label>
                <input class="form-control text-center"
                       value="@($"{Model.Venta?.TotalUnidades:N0}")"
                       readonly />
            </div>
            <div class="col-md-4">
                <label class="form-label">Subtotal del importe (Precios con IVA incluido)</label>
                <input class="form-control text-end"
                       value="@($"{Model.Venta?.SubtotalImporte:C2}")"
                       readonly />
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Subtotal del importe del descuento</label>
                <input class="form-control text-end"
                       value="@($"{Model.Venta?.SubtotalImporteDescuento:C2}")"
                       readonly />
            </div>
            <div class="col-md-4">
                <label class="form-label">Subtotal del importe con descuento</label>
                <input class="form-control text-end"
                       value="@($"{Model.Venta?.SubtotalImporteConDescuento:C2}")"
                       readonly />
            </div>
            <div class="col-md-4">
                <label class="form-label">Subtotal del importe sin IVA</label>
                <input class="form-control text-end"
                       value="@($"{Model.Venta?.SubtotalImporteSinIVA:C2}")"
                       readonly />
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Subtotal del importe del IVA (Incluido)</label>
                <input class="form-control text-end"
                       value="@($"{Model.Venta?.SubtotalImporteConIVA:C2}")"
                       readonly />
            </div>
            <div class="col-md-4">
            </div>
            <div class="col-md-4">
                <label class="form-label"><strong>Total</strong></label>
                <input class="form-control text-end fw-bold"
                       value="@($"{Model.Venta?.Total:C2}")"
                       readonly />
            </div>
        </div>
    </fieldset>
</div>
<br />
<a href="@(Model.ReturnUrl ?? Url.Page("Index"))"
   class="btn btn-sm btn-success me-1 navigation-btn"
   title="Volver">
    <i class="bi bi-check-square"></i>
    <span class="d-none d-md-inline"> Volver</span>
</a>

@if (TempData["Error"] != null)
{
    <a class="btn btn-sm btn-primary me-1 disabled"
       title="Nota de remisión">
        <i class="bi bi-printer"></i>
        <span class="d-none d-md-inline"> Nota de remisión</span>
    </a>
}
else
{
    <a href="javascript:void(0)"
       onclick="disableAndOpen(this, '@Url.Page("/Ventas/Reportes/NotaRemisionRpt", new { handler = "Pdf", orderId = Model.Venta!.OrderID })')"
       class="btn btn-sm btn-primary me-1"
       title="Nota de remisión">
        <i class="bi bi-printer"></i>
        <span class="d-none d-md-inline"> Nota de remisión</span>
    </a>
}
@section Scripts {
    <script src="~/js/loading-overlay.js"></script>
    <script src="~/js/navigation-actions.js"></script>
    <script>
        const hidden = document.getElementById("PestanaActiva");

        document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tab => {
            tab.addEventListener('shown.bs.tab', function() {
                hidden.value = this.dataset.bsTarget;
            });
        });

        $(function() {
            configurarNavegacion();
        });
    </script>
}