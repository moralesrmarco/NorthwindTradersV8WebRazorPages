@page
@model NorthwindTradersV8WebRazorPages.Pages.Graficas.Consultas.VentasPorVendedoresPorAnioModel

<div class="container-fluid">

    <div class="row mb-3">

        <div class="col-auto">
            <label for="cboAnio" class="form-label fw-bold">
                Año:
            </label>

            <select id="cboAnio" class="form-select">

                @foreach (System.Data.DataRow fila in Model.Años.Rows)
                {
                    var valor = Convert.ToInt32(fila["Valor"]);

                    <option value="@valor"
                            selected="@(valor == Model.AñoInicial)">
                        @fila["Texto"]
                    </option>
                }

            </select>
        </div>

    </div>

    <div class="card">

        <div class="card-header fw-bold d-flex justify-content-between align-items-center">

            <span id="tituloGrafica">
                » Gráfica de ventas por vendedores del año
                @Model.AñoInicial
                «
            </span>

            <span id="totalVentas" class="small"></span>

        </div>

        <div class="card-body">

            <div style="position: relative; height: 550px;">
                <canvas id="chartVentasVendedores"></canvas>
            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>

    <script>

        let chartVentasVendedores = null;

        const colores = [
            'rgb(52, 152, 219)',
            'rgb(231, 76, 60)',
            'rgb(46, 204, 113)',
            'rgb(155, 89, 182)',
            'rgb(241, 196, 15)',
            'rgb(230, 126, 34)',
            'rgb(26, 188, 156)',
            'rgb(52, 73, 94)',
            'rgb(127, 140, 141)',
            'rgb(192, 57, 43)'
        ];

        async function cargarVentasPorVendedores(anio) {

            mostrarLoadingOverlay();

            try {

                const url =
                    '@Url.Page(
                        "/Graficas/Consultas/VentasPorVendedoresPorAnio",
                        null,
                        new { handler = "VentasPorVendedores" }
                    )'
                    + '&anio='
                    + anio;

                const response = await fetch(url);

                if (!response.ok) {

                    throw new Error(
                        "Error al obtener las ventas por vendedor."
                    );

                }

                const datos = await response.json();

                dibujarGrafica(datos, anio);

            }
            catch (error) {

                console.error(error);

                alert(
                    "Ocurrió un error al cargar las ventas por vendedor."
                );

            }
            finally {

                ocultarLoadingOverlay();

            }

        }

        function dibujarGrafica(datos, anio) {

            let titulo;

            if (anio < 0) {

                titulo =
                    "» Gráfica de ventas por vendedores de todos los años «";

            }
            else {

                titulo =
                    "» Gráfica de ventas por vendedores del año " +
                    anio +
                    " «";

            }

            document.getElementById("tituloGrafica").textContent =
                titulo;

            let textoTotal;

            if (anio < 0) {

                textoTotal =
                    "Total de ventas (todos los años): ";

            }
            else {

                textoTotal =
                    "Total de ventas (" +
                    anio +
                    "): ";

            }

            document.getElementById("totalVentas").textContent =
                textoTotal +
                new Intl.NumberFormat(
                    'es-MX',
                    {
                        style: 'currency',
                        currency: 'MXN',
                        minimumFractionDigits: 2
                    }
                ).format(datos.totalVentas);

            if (chartVentasVendedores !== null) {

                chartVentasVendedores.destroy();

            }

            const etiquetas =
                datos.vendedores.map(
                    vendedor => vendedor.vendedor
                );

            const valores =
                datos.vendedores.map(
                    vendedor =>
                        Number(vendedor.totalVentas)
                );

            const coloresVendedores =
                datos.vendedores.map(
                    (vendedor, index) =>
                        colores[
                            index % colores.length
                        ]
                );

            Chart.register(ChartDataLabels);

            const ctx =
                document
                    .getElementById("chartVentasVendedores")
                    .getContext("2d");

            chartVentasVendedores = new Chart(ctx, {

                type: 'doughnut',

                data: {

                    labels: etiquetas,

                    datasets: [{

                        data: valores,

                        backgroundColor:
                            coloresVendedores,

                        borderColor: '#ffffff',

                        borderWidth: 2,

                        hoverOffset: 10

                    }]

                },

                options: {

                    cutout: '35%',

                    responsive: true,

                    maintainAspectRatio: false,

                    plugins: {

                        legend: {

                            display: true,

                            position: 'right',

                            labels: {

                                usePointStyle: true,

                                generateLabels: function(chart) {

                                    const data =
                                        chart.data;

                                    if (!data.labels.length) {
                                        return [];
                                    }

                                    return data.labels.map(
                                        (label, index) => {

                                            const valor =
                                                data.datasets[0]
                                                    .data[index];

                                            return {

                                                text:
                                                    label +
                                                    ': ' +
                                                    new Intl.NumberFormat(
                                                        'es-MX',
                                                        {
                                                            style: 'currency',
                                                            currency: 'MXN',
                                                            minimumFractionDigits: 2
                                                        }
                                                    ).format(valor),

                                                fillStyle:
                                                    data.datasets[0]
                                                        .backgroundColor[index],

                                                strokeStyle:
                                                    data.datasets[0]
                                                        .borderColor,

                                                lineWidth:
                                                    data.datasets[0]
                                                        .borderWidth,

                                                hidden: false,

                                                index: index

                                            };

                                        }
                                    );

                                }

                            }

                        },

                        datalabels: {

                            display: true,

                            color: '#ffffff',

                            formatter: function(value) {

                                return new Intl.NumberFormat(
                                    'es-MX',
                                    {
                                        style: 'currency',
                                        currency: 'MXN',
                                        minimumFractionDigits: 2
                                    }
                                ).format(value);

                            },

                            font: {

                                size: 11,

                                weight: 'bold'

                            }

                        },

                        tooltip: {

                            callbacks: {

                                label: function(context) {

                                    const valor =
                                        context.parsed;

                                    return (
                                        'Vendedor: ' +
                                        context.label +
                                        ' | Total ventas: ' +
                                        new Intl.NumberFormat(
                                            'es-MX',
                                            {
                                                style: 'currency',
                                                currency: 'MXN',
                                                minimumFractionDigits: 2
                                            }
                                        ).format(valor)
                                    );

                                }

                            }

                        }

                    }

                }

            });

        }

        document
            .getElementById("cboAnio")
            .addEventListener("change", function() {

                const anio =
                    parseInt(this.value);

                if (isNaN(anio)) {

                    return;

                }

                cargarVentasPorVendedores(anio);

            });

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                cargarVentasPorVendedores(
                    @Model.AñoInicial
                );

            }
        );

    </script>
}