@page
@model NorthwindTradersV8WebRazorPages.Pages.Graficas.Consultas.VentasMensualesPorVendedorPorAnioModel

<div class="container-fluid">

    <div class="row mb-3">
        <div class="col-auto">

            <label for="cboAnio" class="form-label fw-bold">
                Ventas mensuales por vendedor del año:
            </label>

            <select id="cboAnio" class="form-select">

                @foreach (System.Data.DataRow fila in Model.Años.Rows)
                {
                    var valor = Convert.ToInt32(fila["Valor"]);

                    <option value="@valor" selected="@(valor == Model.AñoActual)">
                        @fila["Texto"]
                    </option>
                }

            </select>

        </div>
    </div>


    <div class="card">

        <div class="card-header fw-bold d-flex justify-content-between align-items-center">

            <span id="tituloGrafica">
                » Ventas mensuales por vendedores
                <span id="tituloAnio"></span>
                «
            </span>

            <span id="totalVentas" class="small">
            </span>

        </div>


        <div class="card-body">

            <div style="position: relative; height: 550px;">
                <canvas id="chartVentas"></canvas>
            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>


    <script>

        console.log("SCRIPT VentasMensualesPorVendedorPorAnio CARGADO");


        let chartVentas = null;


        // ==========================================================
        // CARGAR DATOS
        // ==========================================================

        async function cargarVentasMensualesPorVendedor(year) {

            mostrarLoadingOverlay();

            try {

                const url =
                    '@Url.Page(
                                                    "/Graficas/Consultas/VentasMensualesPorVendedorPorAnio",
                            null,
                            new
                                {
                                                    handler = "VentasMensualesPorVendedorPorAnio"
                                }
                                    )'
                    + '&year=' + year;


                const response = await fetch(url);


                if (!response.ok) {

                    throw new Error(
                        "Error al obtener las ventas mensuales por vendedor."
                    );

                }


                const datos = await response.json();


                console.log(
                    "Respuesta recibida:",
                    datos
                );


                // AQUÍ SE DIBUJA LA GRÁFICA

                dibujarGrafica(
                    datos,
                    year
                );

            }
            catch (error) {

                console.error(error);

                alert(
                    "Ocurrió un error al cargar las ventas mensuales por vendedor."
                );

            }
            finally {

                ocultarLoadingOverlay();

            }

        }


        // ==========================================================
        // DIBUJAR GRÁFICA
        // ==========================================================

        function dibujarGrafica(datos, year) {

            console.log(
                "ENTRÓ A dibujarGrafica"
            );


            console.log(
                "Cantidad de registros:",
                datos.length
            );


            console.log(
                "Primer registro:",
                datos[0]
            );


            // ======================================================
            // TÍTULO
            // ======================================================

            if (year === -1) {

                document.getElementById(
                    "tituloAnio"
                ).textContent =
                    "de todos los años";

            }
            else {

                document.getElementById(
                    "tituloAnio"
                ).textContent =
                    "del año " + year;

            }


            // ======================================================
            // TOTAL GENERAL
            // ======================================================

            const totalGeneral = datos.reduce(
                (total, fila) =>
                    total + Number(
                        fila.totalVentas || 0
                    ),
                0
            );


            let textoTotal;


            if (year === -1) {

                textoTotal =
                    "Total de ventas (todos los años): ";

            }
            else {

                textoTotal =
                    "Total de ventas (" +
                    year +
                    "): ";

            }


            document.getElementById(
                "totalVentas"
            ).textContent =
                textoTotal +
                new Intl.NumberFormat(
                    'es-MX',
                    {
                        style: 'currency',
                        currency: 'MXN',
                        minimumFractionDigits: 2
                    }
                ).format(totalGeneral);


            // ======================================================
            // MESES
            // ======================================================

            const meses = [];


            datos.forEach(fila => {

                if (!meses.includes(fila.nombreMes)) {

                    meses.push(
                        fila.nombreMes
                    );

                }

            });


            // ======================================================
            // VENDEDORES
            // ======================================================

            const vendedores = [];


            console.log(
                "Iniciando agrupación de vendedores"
            );


            datos.forEach(fila => {

                if (!vendedores.includes(fila.vendedor)) {

                    vendedores.push(
                        fila.vendedor
                    );

                }

            });


            console.log(
                "Vendedores encontrados:",
                vendedores
            );


            // ======================================================
            // COLORES
            // ======================================================

            const colores = [

                'rgb(52, 152, 219)',
                'rgb(231, 76, 60)',
                'rgb(46, 204, 113)',
                'rgb(155, 89, 182)',
                'rgb(241, 196, 15)',
                'rgb(230, 126, 34)',
                'rgb(26, 188, 156)',
                'rgb(52, 73, 94)',
                'rgb(127, 140, 141)',
                'rgb(243, 156, 18)'

            ];


            // ======================================================
            // CREAR DATASETS
            // ======================================================

            const datasets = vendedores.map(
                (vendedor, indice) => {

                    const datosVendedor =
                        datos.filter(
                            fila =>
                                fila.vendedor === vendedor
                        );


                    const valores = meses.map(
                        mes => {

                            const fila =
                                datosVendedor.find(
                                    x =>
                                        x.nombreMes === mes
                                );


                            return fila
                                ? Number(
                                    fila.totalVentas || 0
                                )
                                : 0;

                        }
                    );


                    // ==============================================
                    // TOTAL DEL VENDEDOR
                    // ==============================================

                    const totalVendedor =
                        valores.reduce(
                            (total, valor) =>
                                total + valor,
                            0
                        );


                    const color =
                        colores[
                        indice % colores.length
                        ];


                    return {

                        label:
                            vendedor +
                            " (Total: " +
                            new Intl.NumberFormat(
                                'es-MX',
                                {
                                    style: 'currency',
                                    currency: 'MXN',
                                    minimumFractionDigits: 2
                                }
                            ).format(totalVendedor) +
                            ")",


                        data: valores,


                        borderColor: color,

                        backgroundColor: color,

                        pointBackgroundColor: color,

                        pointBorderColor: color,


                        borderWidth: 2,


                        pointRadius: 5,

                        pointHoverRadius: 9,


                        tension: 0,


                        fill: false

                    };

                }
            );


            // ======================================================
            // CANVAS
            // ======================================================

            const ctx =
                document
                    .getElementById(
                        "chartVentas"
                    )
                    .getContext("2d");


            // ======================================================
            // REGISTRAR PLUGIN
            // ======================================================

            Chart.register(
                ChartDataLabels
            );


            // ======================================================
            // DESTRUIR GRÁFICA ANTERIOR
            // ======================================================

            if (chartVentas !== null) {

                chartVentas.destroy();

            }


            // ======================================================
            // CREAR GRÁFICA
            // ======================================================

            chartVentas =
                new Chart(
                    ctx,
                    {

                        type: 'line',


                        data: {

                            labels: meses,

                            datasets: datasets

                        },


                        options: {

                            responsive: true,

                            maintainAspectRatio: false,


                            interaction: {

                                mode: 'nearest',

                                intersect: false

                            },


                            plugins: {

                                // ==================================
                                // LEYENDA
                                // ==================================

                                legend: {

                                    display: true,

                                    position: 'top'

                                },


                                // ==================================
                                // ETIQUETAS
                                // ==================================

                                datalabels: {

                                    display:
                                        function(context) {

                                            return context
                                                .dataset
                                                .data[
                                                context.dataIndex
                                            ] > 0;

                                        },


                                    anchor: 'end',

                                    align: 'top',


                                    formatter:
                                        function(value) {

                                            if (value <= 0) {

                                                return '';

                                            }


                                            return new Intl.NumberFormat(
                                                'es-MX',
                                                {
                                                    style: 'currency',
                                                    currency: 'MXN',
                                                    minimumFractionDigits: 2
                                                }
                                            ).format(value);

                                        },


                                    font: {

                                        size: 10,

                                        weight: 'bold'

                                    }

                                },


                                // ==================================
                                // TOOLTIP
                                // ==================================

                                tooltip: {

                                    callbacks: {

                                        title:
                                            function(context) {

                                                return context[0]
                                                    .dataset
                                                    .label
                                                    .split(
                                                        " (Total:"
                                                    )[0];

                                            },


                                        label:
                                            function(context) {

                                                return 'Mes: ' +
                                                    context.label +
                                                    ' | Ventas: ' +
                                                    new Intl.NumberFormat(
                                                        'es-MX',
                                                        {
                                                            style: 'currency',
                                                            currency: 'MXN',
                                                            minimumFractionDigits: 2
                                                        }
                                                    ).format(
                                                        context.parsed.y
                                                    );

                                            }

                                    }

                                }

                            },


                            // ==================================================
                            // EJES
                            // ==================================================

                            scales: {

                                // ==============================================
                                // EJE X
                                // ==============================================

                                x: {

                                    title: {

                                        display: true,

                                        text: 'Meses'

                                    }

                                },


                                // ==============================================
                                // EJE Y
                                // ==============================================

                                y: {

                                    beginAtZero: true,


                                    title: {

                                        display: true,

                                        text: 'Ventas totales'

                                    },


                                    ticks: {

                                        callback:
                                            function(value) {

                                                return new Intl.NumberFormat(
                                                    'es-MX',
                                                    {
                                                        style: 'currency',
                                                        currency: 'MXN',
                                                        maximumFractionDigits: 0
                                                    }
                                                ).format(value);

                                            }

                                    }

                                }

                            }

                        }

                    }
                );

        }


        // ==========================================================
        // CAMBIO DE AÑO
        // ==========================================================

        document
            .getElementById("cboAnio")
            .addEventListener(
                "change",
                function() {

                    const year =
                        parseInt(
                            this.value
                        );


                    if (year === 0) {

                        return;

                    }


                    cargarVentasMensualesPorVendedor(
                        year
                    );

                }
            );


        // ==========================================================
        // CARGA INICIAL
        // ==========================================================

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const combo =
                    document.getElementById(
                        "cboAnio"
                    );


                if (
                    combo &&
                    combo.value !== "0"
                ) {

                    cargarVentasMensualesPorVendedor(
                        parseInt(
                            combo.value
                        )
                    );

                }

            }
        );

    </script>
}