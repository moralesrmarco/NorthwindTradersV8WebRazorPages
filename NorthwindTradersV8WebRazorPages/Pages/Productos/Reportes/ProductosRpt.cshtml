@page
@model NorthwindTradersV8WebRazorPages.Pages.Productos.Reportes.ProductosRptModel
@{
    ViewData["Title"] = "Reporte de productos";
}
<h2>@ViewData["Title"]</h2>

<ul class="nav nav-tabs" id="tabsReporte">
    <li class="nav-item">
        <button type="button"
                class="nav-link active"
                data-bs-toggle="tab"
                data-bs-target="#todos">
            Imprimir todos los productos
        </button>
    </li>
    <li class="nav-item">
        <button type="button"
                class="nav-link"
                data-bs-toggle="tab"
                data-bs-target="#buscar">
            Buscar un producto
        </button>
    </li>
</ul>
<div class="tab-content border border-top-0 p-3">
    <div class="tab-pane fade show active" id="todos">
        <form method="post" target="visorReporte" class="frmPdf">
            <input type="hidden"
                   asp-for="PestanaActiva" />
            <div class="row">
                <div class="col-md-4">
                    <label>Ordenado por</label>
                    <select asp-for="Filtro.OrdenadoPor"
                            asp-items="Model.CamposOrden"
                            class="form-select">
                    </select>
                </div>
                <div class="col-md-4">
                    <label>Dirección</label>
                    <select asp-for="Filtro.AscDesc"
                            asp-items="Model.Direcciones"
                            class="form-select">
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit"
                            class="btn btn-primary"
                            asp-page-handler="VerPdf"
                            data-formato="pdf">
                        <i class="bi bi-printer"></i>
                        Imprimir todos
                    </button>
                </div>
            </div>
            <br />
                <button type="submit"
                        class="btn btn-success"
                        asp-page-handler="Excel"
                        data-no-overlay="true"
                        data-formato="excel">
                    Excel
                </button>
                <button type="submit"
                        class="btn btn-primary"
                        asp-page-handler="Word"
                        data-no-overlay="true"
                        data-formato="word">
                    Word
                </button>
        </form>
    </div>

    <div class="tab-pane fade" id="buscar">
        <form method="post" target="visorReporte" class="frmPdf">
            <input type="hidden"
                   asp-for="PestanaActiva" />
            <div class="row g-3">
                <div class="col-md-2">
                    <label>ID inicial</label>
                    <input asp-for="Filtro.IdIni"
                           class="form-control" 
                           id="txtIdIni" />
                </div>
                <div class="col-md-2">
                    <label>ID final</label>
                    <input asp-for="Filtro.IdFin"
                           class="form-control" 
                           id="txtIdFin" />
                </div>
                <div class="col-md-4">
                    <label>Producto</label>
                    <input asp-for="Filtro.Producto"
                           class="form-control" />
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-4">
                    <label>Categoría</label>
                    <select asp-for="Filtro.Categoria"
                            asp-items="Model.Categorias"
                            class="form-select">
                    </select>
                </div>
                <div class="col-md-4">
                    <label>Proveedor</label>
                    <select asp-for="Filtro.Proveedor"
                            asp-items="Model.Proveedores"
                            class="form-select">
                    </select>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-4">
                    <label>Ordenado por</label>
                    <select asp-for="Filtro.OrdenadoPor"
                            asp-items="Model.CamposOrden"
                            class="form-select">
                    </select>
                </div>
                <div class="col-md-4">
                    <label>Dirección</label>
                    <select asp-for="Filtro.AscDesc"
                            asp-items="Model.Direcciones"
                            class="form-select">
                    </select>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit"
                        class="btn btn-primary"
                        asp-page-handler="VerPdf"
                        data-formato="pdf">
                    <i class="bi bi-printer"></i>
                    Imprimir
                </button>
                <button type="reset"
                        class="btn btn-secondary">
                    Limpiar
                </button>
            </div>
            <br />
            <button type="submit"
                    class="btn btn-success"
                    asp-page-handler="Excel"
                    data-no-overlay="true"
                    data-formato="excel">
                Excel
            </button>
            <button type="submit"
                    class="btn btn-primary"
                    asp-page-handler="Word"
                    data-no-overlay="true"
                    data-formato="word">
                Word
            </button>
        </form>
    </div>
</div>
<p>&nbsp;</p>

<iframe id="visorReporte"
        name="visorReporte"
        width="100%"
        height="600"
        style="border:1px solid #ccc;">
</iframe>

@section Scripts {
    <script src="~/js/loading-overlay.js"></script>
    <script src="~/js/form-buscar.js"></script>
    <script>

        document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tab => {

            tab.addEventListener('shown.bs.tab', function() {

                document.querySelectorAll('input[name="PestanaActiva"]')
                    .forEach(h => h.value = this.dataset.bsTarget);

            });

        });
        const pestana = '@Model.PestanaActiva';

        if (pestana) {

            const boton = document.querySelector(
                `[data-bs-target="${pestana}"]`
            );

            if (boton) {

                new bootstrap.Tab(boton).show();

            }

        }

        // Configurar el formulario del reporte ProductosRpt
        function esMovil() {
            return window.innerWidth <= 768;
        }

        document.querySelectorAll(".frmPdf").forEach(function(frm) {

            frm.addEventListener("submit", function(e) {

                const boton = e.submitter;

                if (!boton) return;

                const formato = boton.dataset.formato;

                if (formato === "pdf") {

                    frm.target = esMovil()
                        ? "_blank"
                        : "visorReporte";

                } else {

                    frm.target = "_self";

                }

            });

        });
    </script>
}