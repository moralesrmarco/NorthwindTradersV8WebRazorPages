@page
@model NorthwindTradersV8WebRazorPages.Pages.Productos.BuscarModel
@{
    ViewData["Title"] = "Buscar Categorías";
}
<h2>@ViewData["Title"]</h2>
<form method="get" onsubmit="return disableSearchButton();">
    <div class="row mb-3">
        <div class="col-md-3">
            <label asp-for="Filtro.IdIni" class="form-label">Id inicial</label>
            <input asp-for="Filtro.IdIni" id="txtIdIni" class="form-control" />
            <span asp-validation-for="Filtro.IdIni" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Filtro.IdFin" class="form-label">Id final</label>
            <input asp-for="Filtro.IdFin" id="txtIdFin" class="form-control" />
            <span asp-validation-for="Filtro.IdFin" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Filtro.Producto" class="form-label">Nombre del producto</label>
            <input asp-for="Filtro.Producto" class="form-control" />
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-3">
            <label asp-for="Filtro.Categoria" class="form-label">Categoría</label>
            <select id="cboCategoria"
                    asp-for="Filtro.Categoria"
                    asp-items="Model.Categorias"
                    class="form-select">
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="Filtro.Proveedor" class="form-label">Proveedor</label>
            <select id="cboProveedor"
                    asp-for="Filtro.Proveedor"
                    asp-items="Model.Proveedores"
                    class="form-select">
            </select>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-6 d-flex gap-2">

            <button id="btnBuscar"
                    type="submit"
                    class="btn btn-sm btn-buscar"
                    title="Buscar">
                <i class="bi bi-search"></i>
                <span class="d-none d-md-inline"> Buscar</span>
            </button>

            <a asp-page="./Buscar"
               class="btn btn-sm btn-primary"
               title="Limpiar">
                <i class="bi bi-eraser"></i>
                <span class="d-none d-md-inline"> Limpiar</span>
            </a>

            <a asp-page="/Productos/Index"
               class="btn btn-sm btn-cancelar navigation-btn"
               title="Cancelar">
                <i class="bi bi-x-circle"></i>
                <span class="d-none d-md-inline"> Cancelar</span>
            </a>
        </div>
    </div>
    @if (Model.SeBusco)
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th class="text-center">ID</th>
                        <th>Producto</th>
                        <th class="text-center">Precio</th>
                        <th class="text-center">Unidades en inventario</th>
                        <th class="text-center">Descontinuado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (System.Data.DataRow row in Model.Productos.Rows)
                    {
                        <tr>
                            <td>@row["ProductID"]</td>
                            <td>@row["ProductName"]</td>
                            <td class="text-center">@string.Format("${0:N2}", row["UnitPrice"])</td>
                            <td class="text-center">@string.Format("{0:N0}", row["UnitsInStock"])</td>
                            <td class="text-center">
                                @if ((bool)row["Discontinued"])
                                {
                                    <span class="badge bg-danger">Descontinuado</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">No</span>
                                }
                            </td>
                            <td class="text-center text-nowrap">
                                <a asp-page="Consultar"
                                   asp-route-id="@row["ProductID"]"
                                   data-show-overlay
                                   asp-route-returnUrl="@(Request.Path + Request.QueryString)"
                                   class="btn btn-sm btn-success me-1 action-btn"
                                   title="Consultar">
                                    <i class="bi bi-check-square"></i>
                                    <span class="d-none d-md-inline"> Consultar</span>
                                </a>
                                <a asp-page="Editar"
                                   asp-route-id="@row["ProductID"]"
                                   data-show-overlay
                                   asp-route-returnUrl="@(Request.Path + Request.QueryString)"
                                   class="btn btn-sm btn-warning me-1 action-btn"
                                   title="Editar">
                                    <i class="bi bi-pencil"></i>
                                    <span class="d-none d-md-inline"> Editar</span>
                                </a>
                                <a asp-page="Eliminar"
                                   asp-route-id="@row["ProductID"]"
                                   data-show-overlay
                                   asp-route-returnUrl="@(Request.Path + Request.QueryString)"
                                   class="btn btn-sm btn-danger me-1 action-btn"
                                   title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                    <span class="d-none d-md-inline"> Eliminar</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</form>
@section Scripts {
    <script src="~/js/navigation-actions.js"></script>
    <script src="~/js/form-buscar.js"></script>
}