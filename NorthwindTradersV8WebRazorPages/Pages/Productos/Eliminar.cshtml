@page "{id:int}"
@model NorthwindTradersV8WebRazorPages.Pages.Productos.EliminarModel
@{
    ViewData["Title"] = "Eliminar producto";
}

<h2>@ViewData["Title"]</h2>

<form method="post" class="form">

    <p>¿Está seguro de eliminar el producto con ID: <strong>@Model.Producto?.ProductID</strong> - Nombre de producto: <strong>@Model.Producto?.ProductName</strong>?</p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@Html.Raw(TempData["Error"])</div>
    }

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Producto.ProductID" class="form-label">ID</label>
            <input asp-for="Producto.ProductID" class="form-control" readonly />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Producto.ProductName" class="form-label">Producto</label>
            <input asp-for="Producto.ProductName" class="form-control" readonly />
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Categoría</label>
            <input value="@(Model.Producto?.Categoria?.CategoryName ?? string.Empty)" class="form-control" readonly />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Proveedor</label>
            <input value="@(Model.Producto?.Proveedor?.CompanyName ?? string.Empty)" class="form-control" readonly />
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Producto.QuantityPerUnit" class="form-label">Cantidad por unidad</label>
            <input asp-for="Producto.QuantityPerUnit" class="form-control" readonly />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Producto.UnitPrice" class="form-label">Precio $</label>
            <input value="@(Model.Producto?.UnitPrice?.ToString("N2") ?? string.Empty)" class="form-control" readonly />
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Producto.UnitsInStock" class="form-label">Unidades en stock</label>
            <input value="@(Model.Producto?.UnitsInStock?.ToString("N0") ?? string.Empty)" class="form-control" readonly />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Producto.UnitsOnOrder" class="form-label">Unidades en orden</label>
            <input value="@(Model.Producto?.UnitsOnOrder?.ToString("N0") ?? string.Empty)" class="form-control" readonly />
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Producto.ReorderLevel" class="form-label">Nivel de reorden</label>
            <input value="@(Model.Producto?.ReorderLevel?.ToString("N0") ?? string.Empty)" class="form-control" readonly />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Descontinuado</label>
            <input value="@(Model.Producto?.Discontinued == true ? "Sí" : "No")" class="form-control" readonly />
        </div>
    </div>

    <input type="hidden" asp-for="Producto.RowVersion" />
    <input type="hidden" asp-for="CategoriaName" value="@(Model.Producto?.Categoria?.CategoryName ?? string.Empty)" />
    <input type="hidden" asp-for="ProveedorName" value="@(Model.Producto?.Proveedor?.CompanyName ?? string.Empty)" />

    <button type="submit" 
        id="btnEliminar"
        class="btn btn-sm btn-danger me-1"
        disabled="@Model.BloquearEliminacion"
        title="Eliminar">
        <i class="bi bi-trash"></i>
        <span class="d-none d-md-inline"> Eliminar</span>
    </button>
    <a href="@(Model.ReturnUrl ?? Url.Page("Index"))"
       class="btn btn-sm btn-cancelar me-1"
       title="Cancelar">
        <i class="bi bi-x-circle"></i>
        <span class="d-none d-md-inline"> Cancelar</span>
    </a>
</form>
@section Scripts {
    <script src="~/js/form-delete.js"></script>
}
