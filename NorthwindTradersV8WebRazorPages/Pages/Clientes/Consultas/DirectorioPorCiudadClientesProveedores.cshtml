@page
@model NorthwindTradersV8WebRazorPages.Pages.Clientes.Consultas.DirectorioPorCiudadClientesProveedoresModel
@{
}
@{
    ViewData["Title"] = "Directorio de clientes y proveedores por ciudad";
}

<h2 class="mb-4">
    @Model.TituloDirectorio
</h2>

<form method="get" class="mb-3">

    <input type="hidden" name="Buscar" value="true" />

    <div class="row align-items-end mb-3">

        <div class="col-md-5">
            <label asp-for="CiudadPaisSeleccionado" class="form-label">
                Buscar por ciudad
            </label>

            <select asp-for="CiudadPaisSeleccionado"
                    asp-items="Model.CiudadesPaises"
                    class="form-select">
            </select>
        </div>

        <div class="col-md-7">
            <div class="form-check form-check-inline">
                <input asp-for="MostrarClientes" class="form-check-input" />
                <label asp-for="MostrarClientes" class="form-check-label">
                    Clientes
                </label>
            </div>

            <div class="form-check form-check-inline">
                <input asp-for="MostrarProveedores" class="form-check-input" />
                <label asp-for="MostrarProveedores" class="form-check-label">
                    Proveedores
                </label>
            </div>

            <button type="submit" class="btn btn-primary btn-sm ms-2">
                Aplicar
            </button>
        </div>

    </div>

</form>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @Html.Raw(TempData["Error"])
    </div>
}
@if (Model.Buscar)
{

    <div class="container mt-4">

        <partial name="_Paginacion" model="Model.PaginacionDirectorio" />

        <p class="text-muted">
            @Model.MensajeResultados
        </p>

        <!-- Fichas de clientes/proveedores -->
        <div class="row">
            @foreach (var clienteProveedor in Model.ClientesProveedores)
            {
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title">Ciudad: @clienteProveedor.City</h5>
                            <h6 class="card-subtitle mb-2 text-muted"><strong>País:</strong> @clienteProveedor.Country</h6>
                            <p class="card-text">
                                <strong>Compañía:</strong> @clienteProveedor.CompanyName <br />
                                <strong>Contacto:</strong> @clienteProveedor.Contact (@clienteProveedor.Relation)<br />
                                <strong>Domicilio:</strong> @clienteProveedor.Address <br />
                                <strong>Region:</strong> @clienteProveedor.Region <br />
                                <strong>Código postal:</strong> @clienteProveedor.PostalCode <br />
                                <strong>Teléfono:</strong> @clienteProveedor.Phone <br />
                                <strong>Fax:</strong> @clienteProveedor.Fax
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <partial name="_Paginacion" model="Model.PaginacionDirectorio" />
}
else
{
    <div class="alert alert-info">
        Seleccione la ciudad, clientes y/o proveedores y haga clic en aplicar.
    </div>
}
@section Scripts {
    <script src="~/js/loading-overlay.js"></script>
}
