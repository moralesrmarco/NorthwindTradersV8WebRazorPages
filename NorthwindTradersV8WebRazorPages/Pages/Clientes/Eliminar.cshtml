@page
@model NorthwindTradersV8WebRazorPages.Pages.Clientes.EliminarModel
@{
}
<h2>Eliminar cliente</h2>
<form method="post" class="form">
    <p>¿Está seguro de eliminar el empleado con ID: <strong>@Model.Cliente?.CustomerID</strong> - Nombre de compañía: <strong>@Model.Cliente?.CompanyName</strong>?</p>
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@Html.Raw(TempData["Error"])</div>
    }
    <div class="row">
        <div class="col-md-2 mb-3">
            <label asp-for="Cliente.CustomerID" class="form-label">ID</label>
            <input asp-for="Cliente.CustomerID" class="form-control" readonly />
        </div>
        <div class="col-md-5 mb-3">
            <label asp-for="Cliente.CompanyName" class="form-label">Nombres</label>
            <input asp-for="Cliente.CompanyName" class="form-control" readonly />
        </div>
        <div class="col-md-5 mb-3">
            <label asp-for="Cliente.ContactName" class="form-label">Apellidos</label>
            <input asp-for="Cliente.ContactName" class="form-control" readonly />
        </div>
    </div>
    <div class="row">
        <div class="col-md-3 mb-3">
            <label asp-for="Cliente.ContactTitle" class="form-label">Título de contacto</label>
            <input asp-for="Cliente.ContactTitle" class="form-control" readonly />
        </div>
        <div class="col-md-9 mb-3">
            <label asp-for="Cliente.Address" class="form-label">Domicilio</label>
            <input asp-for="Cliente.Address" class="form-control" readonly />
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Cliente.City" class="form-label">Ciudad</label>
            <input asp-for="Cliente.City" class="form-control" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Cliente.Region" class="form-label">Región</label>
            <input asp-for="Cliente.Region" class="form-control" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Cliente.PostalCode" class="form-label">Código postal</label>
            <input asp-for="Cliente.PostalCode" class="form-control" readonly />
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Cliente.Country" class="form-label">País</label>
            <input asp-for="Cliente.Country" class="form-control" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Cliente.Phone" class="form-label">Teléfono</label>
            <input asp-for="Cliente.Phone" class="form-control" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Cliente.Fax" class="form-label">Fax</label>
            <input asp-for="Cliente.Fax" class="form-control" readonly />
        </div>
    </div>
    <button type="submit"
            id="btnEliminar"
            class="btn btn-sm btn-danger me-1"
            disabled="@Model.BloquearEliminacion">
        <i class="bi bi-trash"></i> Eliminar
    </button>

    <a href="@(Model.ReturnUrl ?? Url.Page("Index"))"
       class="btn btn-sm btn-cancelar me-1">
        <i class="bi bi-x-circle"></i> Cancelar
    </a>
    <input type="hidden" asp-for="Cliente.RowVersion" />
    <input type="hidden" asp-for="ReturnUrl" />
</form>
@section Scripts {
    <script>
        function disableDeleteButton() {
            var btn = document.getElementById("btnEliminar");
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="bi bi-trash"></i> Eliminando...';
            }
            return true;
        }
    </script>
}