@page
@model NorthwindTradersV8WebRazorPages.Pages.Clientes.IndexModel
@{
}
<h2>Lista de clientes</h2>
<a asp-page="Insertar" 
    class="btn btn-sm btn-primary mb-3" 
    asp-route-returnUrl="@Url.Page("Index", new { pageIndex = Model.PageIndex })"
    title="Nuevo">
    <i class="bi bi-plus-circle"></i>
    <span class="d-none d-md-inline"> Nuevo cliente</span>
</a>
<a asp-page="Buscar" class="btn btn-sm btn-buscar mb-3"
    title="Buscar">
    <i class="bi bi-search"></i>
    <span class="d-none d-md-inline"> Buscar cliente</span>
</a>
@{
    int startPage = Math.Max(1, Model.PageIndex - 2);
    int endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);
}
<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center flex-wrap">
        <!-- Botón Inicio -->
        <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
            <a class="page-link" asp-page="Index" asp-route-pageIndex="1" title="Primera página">
                ««
            </a>
        </li>

        <!-- Botón Anterior -->
        <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
            <a class="page-link" asp-page="Index" asp-route-pageIndex="@(Model.PageIndex - 1)" title="Anterior">
                «
            </a>
        </li>

        <!-- Rango dinámico -->
        @for (int i = startPage; i <= endPage; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a class="page-link" asp-page="Index" asp-route-pageIndex="@i">@i</a>
            </li>
        }

        <!-- Botón Siguiente -->
        <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
            <a class="page-link" asp-page="Index" asp-route-pageIndex="@(Model.PageIndex + 1)" title="Siguiente">
                »
            </a>
        </li>

        <!-- Botón Fin -->
        <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
            <a class="page-link" asp-page="Index" asp-route-pageIndex="@Model.TotalPages" title="Última página">
                »»
            </a>
        </li>
    </ul>
</nav>
<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th class="text-center">ID</th>
                <th>Nombre de compañía</th>
                <th class="text-center">Ciudad</th>
                <th class="text-center">País</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (System.Data.DataRow row in Model.Clientes.Rows)
            {
                <tr>
                    <td class="text-center">@row["CustomerID"]</td>
                    <td>@row["CompanyName"]</td>
                    <td class="text-center">@row["City"]</td>
                    <td class="text-center">@row["Country"]</td>
                    <td class="text-center text-nowrap">
                        <a asp-page="Consultar"
                           asp-route-id="@row["CustomerID"]"
                           asp-route-returnUrl="@Url.Page("Index", new { pageIndex = Model.PageIndex })"
                           class="btn btn-sm btn-success me-1 action-btn"
                            title="Consultar">
                            <i class="bi bi-check-square"></i>
                            <span class="d-none d-md-inline"> Consultar</span>
                        </a>
                        <a asp-page="Editar"
                           asp-route-id="@row["CustomerID"]"
                           asp-route-returnUrl="@Url.Page("Index", new { pageIndex = Model.PageIndex })"
                           class="btn btn-sm btn-warning me-1 action-btn"
                            title="Editar">
                            <i class="bi bi-pencil"></i>
                            <span class="d-none d-md-inline"> Editar</span>
                        </a>                    
                        <a asp-page="Eliminar"
                           asp-route-id="@row["CustomerID"]"
                           asp-route-returnUrl="@Url.Page("Index", new { pageIndex = Model.PageIndex })"
                           class="btn btn-sm btn-danger me-1 action-btn"
                            title="Eliminar">
                            <i class="bi bi-trash"></i>
                            <span class="d-none d-md-inline"> Eliminar</span>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center flex-wrap">
        <!-- Botón Inicio -->
        <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
            <a class="page-link" asp-page="Index" asp-route-pageIndex="1" title="Primera página">
                ««
            </a>
        </li>

        <!-- Botón Anterior -->
        <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
            <a class="page-link" asp-page="Index" asp-route-pageIndex="@(Model.PageIndex - 1)" title="Anterior">
                «
            </a>
        </li>

        <!-- Rango dinámico -->
        @for (int i = startPage; i <= endPage; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a class="page-link" asp-page="Index" asp-route-pageIndex="@i">@i</a>
            </li>
        }

        <!-- Botón Siguiente -->
        <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
            <a class="page-link" asp-page="Index" asp-route-pageIndex="@(Model.PageIndex + 1)" title="Siguiente">
                »
            </a>
        </li>

        <!-- Botón Fin -->
        <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
            <a class="page-link" asp-page="Index" asp-route-pageIndex="@Model.TotalPages" title="Última página">
                »»
            </a>
        </li>
    </ul>
</nav>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const buttons = document.querySelectorAll(".action-btn");

            buttons.forEach(btn => {
                btn.addEventListener("click", function () {
                    // Deshabilita todos los botones al dar clic en cualquiera
                    buttons.forEach(b => {
                        b.classList.add("disabled"); // estilo Bootstrap
                        b.setAttribute("disabled", "true"); // atributo real
                    });
                });
            });
        });
    </script>
}