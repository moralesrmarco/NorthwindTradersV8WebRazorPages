@page
@model NorthwindTradersV8WebRazorPages.Pages.Clientes.IndexModel
@{
}
<h2>Lista de clientes</h2>
<a asp-page="Insertar" 
    class="btn btn-sm btn-primary mb-3" 
    asp-route-returnUrl="@Url.Page("Index", new { pageIndex = Model.PageIndex })"
    title="Nuevo">
    <i class="bi bi-plus-circle"></i>
    <span class="d-none d-md-inline"> Nuevo cliente</span>
</a>
<a asp-page="Buscar" class="btn btn-sm btn-buscar mb-3"
    title="Buscar">
    <i class="bi bi-search"></i>
    <span class="d-none d-md-inline"> Buscar cliente</span>
</a>

<partial name="_Paginacion" model="Model.Paginacion" />

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th class="text-center">ID</th>
                <th>Nombre de compañía</th>
                <th class="text-center">País</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (System.Data.DataRow row in Model.Clientes.Rows)
            {
                <tr>
                    <td class="text-center">@row["CustomerID"]</td>
                    <td>@row["CompanyName"]</td>
                    <td class="text-center">@row["Country"]</td>
                    <td class="text-center text-nowrap">
                        <a asp-page="Consultar"
                           asp-route-id="@row["CustomerID"]"
                           asp-route-returnUrl="@Url.Page("Index", new { pageIndex = Model.PageIndex })"
                           class="btn btn-sm btn-success me-1 action-btn"
                            title="Consultar">
                            <i class="bi bi-check-square"></i>
                            <span class="d-none d-md-inline"> Consultar</span>
                        </a>
                        <a asp-page="Editar"
                           asp-route-id="@row["CustomerID"]"
                           asp-route-returnUrl="@Url.Page("Index", new { pageIndex = Model.PageIndex })"
                           class="btn btn-sm btn-warning me-1 action-btn"
                            title="Editar">
                            <i class="bi bi-pencil"></i>
                            <span class="d-none d-md-inline"> Editar</span>
                        </a>                    
                        <a asp-page="Eliminar"
                           asp-route-id="@row["CustomerID"]"
                           asp-route-returnUrl="@Url.Page("Index", new { pageIndex = Model.PageIndex })"
                           class="btn btn-sm btn-danger me-1 action-btn"
                            title="Eliminar">
                            <i class="bi bi-trash"></i>
                            <span class="d-none d-md-inline"> Eliminar</span>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Paginacion" model="Model.Paginacion" />

@section Scripts {
    <script src="~/js/list-actions.js"></script>

    <script>
        $(function () {
            configurarAccionesListado();
        });
    </script>
}
