@page
@model NorthwindTradersV8WebRazorPages.Pages.Clientes.Reportes.DirectorioClientesProveedoresRptModel
@{
    ViewData["Title"] = "Reporte directorio de clientes y proveedores";
}
<h2 class="mb-4">
    @Model.TituloDirectorio
</h2>
<form method="get" class="mb-3">
    <input type="hidden" name="Buscar" value="true" />
    Buscar por: &nbsp;&nbsp;
    <div class="form-check form-check-inline">
        <input asp-for="MostrarClientes" class="form-check-input" />
        <label asp-for="MostrarClientes" class="form-check-label">
            Clientes
        </label>
    </div>

    <div class="form-check form-check-inline">
        <input asp-for="MostrarProveedores" class="form-check-input" />
        <label asp-for="MostrarProveedores" class="form-check-label">
            Proveedores
        </label>
    </div>

    <button type="submit" class="btn btn-primary btn-sm ms-2">
        Aplicar
    </button>
</form>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @Html.Raw(TempData["Error"])
    </div>
}
@if (Model.Buscar && (Model.MostrarClientes || Model.MostrarProveedores))
{
    <a asp-page-handler="Excel"
       asp-route-Buscar="true" 
       asp-route-MostrarClientes="@Model.MostrarClientes"
       asp-route-MostrarProveedores="@Model.MostrarProveedores"
       class="btn btn-sm btn-success">
        Excel
    </a>

    <a asp-page-handler="Word"
       asp-route-Buscar="true" 
       asp-route-MostrarClientes="@Model.MostrarClientes"
       asp-route-MostrarProveedores="@Model.MostrarProveedores"
       class="btn btn-sm btn-primary">
        Word
    </a>

    <p>&nbsp;</p>

    <iframe id="visorReporte"
            data-report-src="?handler=VerPdf&Buscar=true&MostrarClientes=@Model.MostrarClientes&MostrarProveedores=@Model.MostrarProveedores"
            width="100%"
            height="600"
            style="border:1px solid #ccc;">
    </iframe>}
else
{
    <div class="alert alert-info">
        Seleccione clientes y/o proveedores y haga clic en aplicar.
    </div>
}
@section Scripts {
    <script src="~/js/loading-overlay.js"></script>
}
