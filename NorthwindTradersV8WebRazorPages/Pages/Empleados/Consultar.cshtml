@page "{id:int}"
@model NorthwindTradersV8WebRazorPages.Pages.Empleados.ConsultarModel
@{
}
<h2>Detalles del empleado</h2>
<form method="post" class="form">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@Html.Raw(TempData["Error"])</div>
    }

    <div class="row">
        <div class="col-md-12 mb-3">
            <img src="/Empleados/Foto?id=@Model.Empleado?.EmployeeID"
                 alt="Foto del empleado"
                 class="img-thumbnail float-end"
                 style="max-width:150px; max-height:150px;" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-2 mb-3">
            <label asp-for="Empleado.EmployeeID" class="form-label">ID</label>
            <input asp-for="Empleado.EmployeeID" class="form-control" readonly />
        </div>
        <div class="col-md-5 mb-3">
            <label asp-for="Empleado.FirstName" class="form-label">Nombres</label>
            <input asp-for="Empleado.FirstName" class="form-control" readonly />
        </div>
        <div class="col-md-5 mb-3">
            <label asp-for="Empleado.LastName" class="form-label">Apellidos</label>
            <input asp-for="Empleado.LastName" class="form-control" readonly />
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.Title" class="form-label">Título</label>
            <input asp-for="Empleado.Title" class="form-control" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.TitleOfCourtesy" class="form-label">Título de cortesía</label>
            <input asp-for="Empleado.TitleOfCourtesy" class="form-control" readonly />
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 mb-3">
            <label asp-for="Empleado.Address" class="form-label">Dirección</label>
            <input asp-for="Empleado.Address" class="form-control" readonly />
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.City" class="form-label">Ciudad</label>
            <input asp-for="Empleado.City" class="form-control" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.Region" class="form-label">Región</label>
            <input asp-for="Empleado.Region" class="form-control" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.PostalCode" class="form-label">Código postal</label>
            <input asp-for="Empleado.PostalCode" class="form-control" readonly />
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.Country" class="form-label">País</label>
            <input asp-for="Empleado.Country" class="form-control" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.HomePhone" class="form-label">Teléfono</label>
            <input asp-for="Empleado.HomePhone" class="form-control" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.Extension" class="form-label">Extensión</label>
            <input asp-for="Empleado.Extension" class="form-control" readonly />
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.BirthDate" class="form-label">Fecha de nacimiento</label>
            <input class="form-control"
                   value="@Model.Empleado?.BirthDate?.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))"
                   readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.HireDate" class="form-label">Fecha de contratación</label>
            <input class="form-control"
                   value="@Model.Empleado?.HireDate?.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))"
                   readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Reporta a</label>
            @if (Model.Empleado?.ReportsTo != null)
            {
                <a asp-page="Consultar" asp-route-id="@Model.Empleado.ReportsTo" class="form-control">
                    @Model.Empleado.ReportsToName
                </a>
            }
            else
            {
                <input class="form-control" value="N/A" readonly />
            }
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 mb-3">
            <label asp-for="Empleado.Notes" class="form-label">Notas</label>
            <textarea asp-for="Empleado.Notes"
                      class="form-control"
                      rows="5"
                      readonly
                      style="resize:none; overflow-y:auto; max-height:200px;"></textarea>
        </div>
    </div>

    <a href="javascript:history.back()" class="btn btn-sm btn-success me-1">
        <i class="bi bi-check-circle"></i> Volver
    </a>

    @if (TempData["Error"] != null)
    {
        <a class="btn btn-sm btn-primary me-1 disabled">
            <i class="bi bi-printer"></i> Imprimir
        </a>
    }
    else
    {
        <a href="javascript:void(0)"
           onclick="disableAndOpen(this, '@Url.Page("Consultar", "Reporte", new { id = Model.Empleado?.EmployeeID })')"
           class="btn btn-sm btn-primary me-1">
            <i class="bi bi-printer"></i> Imprimir
        </a>
    }
    @section Scripts {
        <script>
                function openCenteredPopup(url, title, w, h) {
                    var dualScreenLeft = window.screenLeft !== undefined ? window.screenLeft : window.screenX;
                    var dualScreenTop = window.screenTop !== undefined ? window.screenTop : window.screenY;

                    var width = window.innerWidth || document.documentElement.clientWidth || screen.width;
                    var height = window.innerHeight || document.documentElement.clientHeight || screen.height;

                    var left = ((width / 2) - (w / 2)) + dualScreenLeft;
                    var top = ((height / 2) - (h / 2)) + dualScreenTop;

                    var newWindow = window.open(url, title,
                        'scrollbars=yes,resizable=yes,toolbar=no,location=no,status=no,menubar=no,width=' + w + ',height=' + h + ',top=' + top + ',left=' + left);

                    if (window.focus) {
                        newWindow.focus();
                    }
                }

                function disableAndOpen(button, url) {
                    // Quitar el onclick para evitar más clics
                    button.onclick = null;
                    // Agregar clase Bootstrap disabled
                    button.classList.add("disabled");
                    // Abrir el popup
                    openCenteredPopup(url, 'ReporteEmpleado', 900, 700);
                }
        </script>
    }
</form>