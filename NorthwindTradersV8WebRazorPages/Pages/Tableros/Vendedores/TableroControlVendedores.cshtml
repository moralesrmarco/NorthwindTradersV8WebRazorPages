@page
@model NorthwindTradersV8WebRazorPages.Pages.Tableros.Vendedores.TableroControlVendedoresModel
@using System.Data

@{
    ViewData["Title"] = "Tablero de control para vendedores";

    var maxAnios = Math.Min(Model.TotalAniosDisponibles, 10);
}

<div id="tableroControlVendedores" class="container-fluid">

    <h1 class="h3 mb-4">
        Tablero de control — Vendedores
    </h1>

    <div class="row g-4">

        <!-- ========================================================= -->
        <!-- 1. Ventas mensuales por vendedor                         -->
        <!-- ========================================================= -->

        <div class="col-12 col-xxl-6">

            <section class="card h-100 shadow-sm">

                <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">

                    <strong>
                        Ventas mensuales por vendedor
                    </strong>

                    <select id="anioLinea"
                            class="form-select form-select-sm w-auto">

                        @foreach (DataRow fila in Model.Anios.Rows)
                        {
                            var valor = Convert.ToInt32(fila["Valor"]);

                            <option value="@valor"
                                    selected="@(valor == Model.AnioInicial)">
                                @fila["Texto"]
                            </option>
                        }

                    </select>

                </div>

                <div class="card-body chart-container">

                    <canvas id="chartLinea"></canvas>

                </div>

            </section>

        </div>


        <!-- ========================================================= -->
        <!-- 2. Comparativo de ventas mensuales                       -->
        <!-- ========================================================= -->

        <div class="col-12 col-xxl-6">

            <section class="card h-100 shadow-sm">

                <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">

                    <strong>
                        Comparativo de ventas mensuales
                    </strong>

                    <select id="aniosComparativo"
                            class="form-select form-select-sm w-auto">

                        @for (var i = 2; i <= maxAnios; i++)
                        {
                            <option value="@i"
                                    selected="@(i == maxAnios)">
                                Últimos @i años
                            </option>
                        }

                    </select>

                </div>

                <div class="card-body chart-container">

                    <canvas id="chartComparativo"></canvas>

                </div>

            </section>

        </div>


        <!-- ========================================================= -->
        <!-- 3. Top productos más vendidos                            -->
        <!-- ========================================================= -->

        <div class="col-12 col-xxl-6">

            <section class="card h-100 shadow-sm">

                <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">

                    <strong>
                        Top productos más vendidos
                    </strong>

                    <div class="d-flex gap-2">

                        <select id="cantidadProductos"
                                class="form-select form-select-sm">

                            @for (var i = 10; i <= 30; i += 5)
                            {
                                <option value="@i"
                                        selected="@(i == 20)">
                                    Top @i
                                </option>
                            }

                        </select>

                        <select id="anioProductos"
                                class="form-select form-select-sm">

                            @foreach (DataRow fila in Model.Anios.Rows)
                            {
                                var valor = Convert.ToInt32(fila["Valor"]);

                                <option value="@valor"
                                        selected="@(valor == Model.AnioInicial)">
                                    @fila["Texto"]
                                </option>
                            }

                        </select>

                    </div>

                </div>

                <div class="card-body chart-container">

                    <canvas id="chartProductos"></canvas>

                </div>

            </section>

        </div>


        <!-- ========================================================= -->
        <!-- 4. Ventas mensuales por vendedor — barras                -->
        <!-- ========================================================= -->

        <div class="col-12 col-xxl-6">

            <section class="card h-100 shadow-sm">

                <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">

                    <strong>
                        Ventas mensuales por vendedor — barras
                    </strong>

                    <select id="anioBarras"
                            class="form-select form-select-sm w-auto">

                        @foreach (DataRow fila in Model.Anios.Rows)
                        {
                            var valor = Convert.ToInt32(fila["Valor"]);

                            <option value="@valor"
                                    selected="@(valor == Model.AnioInicial)">
                                @fila["Texto"]
                            </option>
                        }

                    </select>

                </div>

                <div class="card-body chart-container">

                    <canvas id="chartBarras"></canvas>

                </div>

            </section>

        </div>


        <!-- ========================================================= -->
        <!-- 5. Ventas por vendedor                                   -->
        <!-- ========================================================= -->

        <div class="col-12 col-xxl-6">

            <section class="card h-100 shadow-sm">

                <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">

                    <strong>
                        Ventas por vendedor
                    </strong>

                    <select id="anioDona"
                            class="form-select form-select-sm w-auto">

                        @foreach (DataRow fila in Model.Anios.Rows)
                        {
                            var valor = Convert.ToInt32(fila["Valor"]);

                            <option value="@valor"
                                    selected="@(valor == Model.AnioInicial)">
                                @fila["Texto"]
                            </option>
                        }

                    </select>

                </div>

                <div class="card-body chart-container">

                    <canvas id="chartDona"></canvas>

                </div>

            </section>

        </div>

    </div>

</div>


@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>

    <script src="~/js/tablero-control-vendedores.js"
            asp-append-version="true">
    </script>
}
