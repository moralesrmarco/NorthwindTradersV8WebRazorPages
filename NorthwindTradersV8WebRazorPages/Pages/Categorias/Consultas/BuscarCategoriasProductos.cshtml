@page
@model NorthwindTradersV8WebRazorPages.Pages.Categorias.Consultas.BuscarCategoriasProductosModel
@{
    ViewData["Title"] = "Consulta de productos por categoría";
}
<h2>Consulta de productos por categoría <i class="bi bi-arrow-right"></i> Buscar categoría</h2>
<form method="get" onsubmit="return disableSearchButton();">
    <div class="row mb-3">
        <div class="col-md-3">
            <label asp-for="Filtro.IdIni" class="form-label">Id inicial</label>
            <input asp-for="Filtro.IdIni" id="txtIdIni" class="form-control" />
            <span asp-validation-for="Filtro.IdIni" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Filtro.IdFin" class="form-label">Id final</label>
            <input asp-for="Filtro.IdFin" id="txtIdFin" class="form-control" />
            <span asp-validation-for="Filtro.IdFin" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Filtro.CategoryName" class="form-label">Categoria</label>
            <input asp-for="Filtro.CategoryName" class="form-control" />
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-6 d-flex gap-2">
            <button id="btnBuscar"
                    type="submit"
                    class="btn btn-sm btn-buscar"
                    title="Buscar">
                <i class="bi bi-search"></i>
                <span class="d-none d-md-inline"> Buscar</span>
            </button>
            <a asp-page="./Buscar"
               class="btn btn-sm btn-primary"
               title="Limpiar">
                <i class="bi bi-eraser"></i>
                <span class="d-none d-md-inline"> Limpiar</span>
            </a>
            <a asp-page="/Categorias/Index"
               class="btn btn-sm btn-cancelar navigation-btn"
               title="Cancelar">
                <i class="bi bi-x-circle"></i>
                <span class="d-none d-md-inline"> Cancelar</span>
            </a>
        </div>
    </div>
    @if (Model.SeBusco)
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th class="text-center">Imagen</th>
                        <th class="text-center">ID</th>
                        <th>Categoría</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (System.Data.DataRow row in Model.Categorias.Rows)
                    {
                        <tr>
                            <td class="text-center">
                                <img src="/Categorias/Picture?id=@row["CategoryID"]"
                                     alt="Picture"
                                     class="img-thumbnail"
                                     style="max-width: 80px; max-height: 80px;" />
                            </td>
                            <td class="text-center">@row["CategoryID"]</td>
                            <td>@row["CategoryName"]</td>
                            <td class="text-center text-nowrap">
                                <a asp-page="/Categorias/Consultar"
                                   asp-route-id="@row["CategoryID"]"
                                   asp-route-returnUrl="@(Request.Path + Request.QueryString)"
                                   class="btn btn-sm btn-success me-1 action-btn"
                                   title="Consultar">
                                    <i class="bi bi-check-square"></i>
                                    <span class="d-none d-md-inline"> Consultar</span>
                                </a>
                                <a asp-page="ProductosPorCategoria"
                                   asp-route-id="@row["CategoryID"]"
                                   asp-route-returnUrl="@(Request.Path + Request.QueryString)"
                                   class="btn btn-sm btn-primary me-1 action-btn"
                                   title="Productos">
                                    <i class="bi bi-cart"></i>
                                    <span class="d-none d-md-inline"> Productos</span>
                                </a>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </form>
    @section Scripts {
        <script src="~/js/navigation-actions.js"></script>
        <script src="~/js/form-buscar.js"></script>
    }