@page "{id:int}"
@model NorthwindTradersV8WebRazorPages.Pages.Categorias.EliminarModel
@{
    ViewData["Title"] = "Eliminar categoría";
}
<h2>Eliminar categoría</h2>
<form method="post" class="form">
    <p>¿Está seguro de eliminar la categoría con ID: <strong>@Model.Categoria?.CategoryID</strong> - Nombre de categoría: <strong>@Model.Categoria?.CategoryName</strong>?</p>
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@Html.Raw(TempData["Error"])</div>
    }
    <div class="row mb-3">
        <div class="col-md-12">
            <label asp-for="Categoria.CategoryID" class="form-label">ID</label>
            <input asp-for="Categoria.CategoryID" class="form-control" readonly />
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-12">
            <label asp-for="Categoria.CategoryName" class="form-label">Nombre</label>
            <input asp-for="Categoria.CategoryName" class="form-control" readonly />
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-12">
            <label asp-for="Categoria.Description" class="form-label">Descripción</label>
            <textarea asp-for="Categoria.Description" class="form-control" readonly></textarea>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-12">
            <img src="/Categorias/Picture?id=@Model.Categoria?.CategoryID"
                 alt="Imagen de la categoría"
                 class="img-thumbnail float-start"
                 style="max-width:250px; max-height:250px;" />
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-12">
            <button type="submit"
                    id="btnEliminar"
                    class="btn btn-sm btn-danger me-1"
                    disabled="@Model.BloquearEliminacion"
                    title="Eliminar">
                <i class="bi bi-trash"></i>
                <span class="d-none d-md-inline"> Eliminar</span>
            </button>

            <a href="@(Model.ReturnUrl ?? Url.Page("Index"))"
               class="btn btn-sm btn-cancelar me-1"
               title="Cancelar">
                <i class="bi bi-x-circle"></i>
                <span class="d-none d-md-inline"> Cancelar</span>
            </a>
            <input type="hidden" asp-for="Categoria.RowVersion" />
        </div>
    </div>
</form>
@section Scripts {
    <script src="~/js/form-delete.js"></script>
}
